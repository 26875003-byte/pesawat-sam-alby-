}
function updatePickups(dt){
  var magnetRange=buffs.magnet>0?450:110;
  for(var i=pickups.length-1;i>=0;i--){
    var p=pickups[i];
    p.life-=dt;p.bob+=dt*4;
    var d=Math.sqrt(d2(p.x,p.y,P.x,P.y));
    if(d<magnetRange&&d>1){
      var a=Math.atan2(P.y-p.y,P.x-p.x);
      var speed=((magnetRange-d)/magnetRange)*700;
      p.x+=Math.cos(a)*speed*dt;
      p.y+=Math.sin(a)*speed*dt;
    }else{
      p.x+=p.vx*dt;p.y+=p.vy*dt;
      p.vx*=0.96;p.vy=p.vy*0.96+30*dt;
    }
    if(d<P.r+18){applyPickup(p.type);pickups.splice(i,1);continue}
    if(p.life<=0||p.y>H+50) pickups.splice(i,1);
  }
}
function updateCombo(dt){
  if(combo.timer>0){
    combo.timer-=dt;
    if(combo.timer<=0){
      if(combo.count>combo.bestCombo) combo.bestCombo=combo.count;
      combo.count=0;combo.multiplier=1;
    }
  }else if(combo.count>0){combo.count=0;combo.multiplier=1}
  if(G.comboFlash>0) G.comboFlash-=dt*3;
}
function addCombo(){
  combo.count++;
  combo.timer=2.5;
  if(combo.count>combo.bestCombo) combo.bestCombo=combo.count;
  combo.multiplier=1+Math.floor(combo.count/5)*0.5;
  G.comboFlash=1;
  G.comboDisplay=combo.count;
}

/* ═══════ BLOOD ═══════ */
var BLOOD_COLORS=['#ff0033','#c1001f','#8b0000','#d40824','#ff1a3d'];
function bloodColor(){return BLOOD_COLORS[Math.floor(Math.random()*BLOOD_COLORS.length)]}
function addBloodBurst(x,y,intensity,opts){
  if(!settings.bloodEffects) return;
  opts=opts||{};
  var mult=intensity||1;
  var count=Math.floor(18*mult);
  for(var i=0;i<count;i++){
    var a=Math.random()*TAU;
    var spd=rnd(60,420)*mult;
    var dirBias=opts.upBias?-Math.abs(Math.sin(a)):Math.sin(a);
    particles.push({x:x+rnd(-4,4),y:y+rnd(-4,4),
      vx:Math.cos(a)*spd,vy:dirBias*spd,
      life:rnd(0.5,1.3)*Math.min(mult,1.5),maxLife:1.3,
      color:bloodColor(),size:rnd(1.6,4.2)*Math.min(mult,1.6),
      gravity:420,blood:true,drag:0.93});
  }
  var mistN=Math.floor(8*mult);
  for(var j=0;j<mistN;j++){
    var a2=Math.random()*TAU;
    var spd2=rnd(20,90);
    particles.push({x:x,y:y,vx:Math.cos(a2)*spd2,vy:Math.sin(a2)*spd2,
      life:rnd(0.8,1.8),maxLife:1.8,color:'#5c0000',size:rnd(3,8),
      gravity:-20,blood:true,mist:true,drag:0.92});
  }
}
function addBloodDecal(x,y,size,opts){
  if(!settings.bloodEffects) return;
  opts=opts||{};
  var baseR=Math.max(8,size);
  var splats=[];
  var n=3+Math.floor(Math.random()*5);
  for(var i=0;i<n;i++){
    var a=Math.random()*TAU;
    var d=baseR*rnd(0.4,1.6);
    splats.push({dx:Math.cos(a)*d,dy:Math.sin(a)*d*(opts.flat?0.45:1),r:baseR*rnd(0.2,0.7)});
  }
  bloodDecals.push({x:x,y:y,r:baseR*rnd(0.8,1.2),
    life:opts.persist?6.5:4.2,maxLife:opts.persist?6.5:4.2,
    splats:splats,flat:opts.flat||false,alpha:opts.alpha||0.75});
  while(bloodDecals.length>50) bloodDecals.shift();
}
function addBloodDrip(){
  if(!settings.bloodEffects) return;
  bloodDrips.push({x:Math.random()*W,y:-10,vy:rnd(60,160),len:rnd(30,90),
    w:rnd(2,5),life:rnd(2.5,5),maxLife:5,
    wobble:Math.random()*TAU,wobbleSpd:rnd(1.5,3.5)});
  while(bloodDrips.length>22) bloodDrips.shift();
}

/* ═══════ ENEMIES ═══════ */
function nearestPlayer(x,y){
  if(!R) return P;
  if(P.dead&&!R.dead) return R;
  if(R.dead&&!P.dead) return P;
  if(P.dead&&R.dead) return P;
  var dP=d2(x,y,P.x,P.y);
  var dR=d2(x,y,R.x,R.y);
  return dP<=dR?P:R;
}
function pickEnemyType(level){
  var pool=['grunt'];
  if(level>=2) pool.push('zig');
  if(level>=3) pool.push('diver');
  if(level>=5) pool.push('grunt','zig');
  if(level>=7) pool.push('tank');
  if(level>=10) pool.push('sniper');
  if(level>=15) pool.push('tank','sniper','zig','diver');
  if(level>=30) pool.push('tank','sniper');
  return pool[Math.floor(Math.random()*pool.length)];
}
function spawnEnemy(level){
  var type=pickEnemyType(level);
  var x=rnd(80,Math.max(90,W-80));
  var hpMult=isOnline?1.5:1;
  var baseHp=(20+level*8)*hpMult;
  var e={type:type,x:x,y:-60,t:0,hitFlash:0,
    fireCd:rnd(1.0,2.4),phase:Math.random()*TAU,
    r:26,hp:baseHp,maxHp:baseHp,vy:100,vx:0,score:10,amp:0,stopY:0,angle:0};
  switch(type){
    case 'grunt':e.r=26;e.vy=Math.min(500,95+level*2);e.score=10;break;
    case 'zig':e.r=24;e.hp=e.maxHp=baseHp*0.9;e.vy=Math.min(400,80+level*1.6);e.amp=130;e.score=15;break;
    case 'diver':e.r=22;e.hp=e.maxHp=baseHp*0.7;e.vy=Math.min(620,250+level*3);e.score=12;break;
    case 'tank':e.r=42;e.hp=e.maxHp=baseHp*3;e.vy=Math.min(200,55+level*0.8);e.score=45;break;
    case 'sniper':e.r=28;e.hp=e.maxHp=baseHp*1.6;e.vy=Math.min(300,130+level*1.2);e.stopY=rnd(120,240);e.score=30;break;
  }
  e.y=-e.r-30;
  enemies.push(e);
}
function enemyShoot(e){
  var target=nearestPlayer(e.x,e.y);
  var a=Math.atan2(target.y-e.y,target.x-e.x);
  var spd=Math.min(480,200+G.level*2.2);
  if(e.type==='tank'){
    for(var i=-1;i<=1;i++){
      var aa=a+i*0.28;
      spawnEBullet(e.x,e.y+e.r*0.5,Math.cos(aa)*spd*0.8,Math.sin(aa)*spd*0.8,8,'#ff9f1c');
    }
    sfx(180,0.12,'sawtooth',0.035);
  }else if(e.type==='sniper'){
    spawnEBullet(e.x,e.y+e.r*0.5,Math.cos(a)*spd*1.5,Math.sin(a)*spd*1.5,6,'#ffd166');
    sfx(520,0.08,'square',0.03);
  }else{
    spawnEBullet(e.x,e.y+e.r*0.5,Math.cos(a)*spd,Math.sin(a)*spd,6,'#ff4d6d');
    sfx(300,0.07,'square',0.025);
  }
}
function updateEnemies(dt){
  for(var i=enemies.length-1;i>=0;i--){
    var e=enemies[i];
    e.t+=dt;
    if(e.hitFlash>0) e.hitFlash-=dt;
    if(e.type==='zig'){e.y+=e.vy*dt;e.x+=Math.cos(e.t*3+e.phase)*e.amp*dt*2.2}
    else if(e.type==='sniper'){if(e.y<e.stopY) e.y+=e.vy*dt;else e.y+=Math.sin(e.t*2.2)*30*dt}
    else e.y+=e.vy*dt;
    e.angle=Math.atan2(P.y-e.y,P.x-e.x);
    if(e.hp<e.maxHp*0.5&&Math.random()<0.15&&settings.bloodEffects){
      particles.push({x:e.x+rnd(-e.r*0.4,e.r*0.4),y:e.y+e.r*0.6,
        vx:rnd(-30,30),vy:rnd(30,90),life:rnd(0.4,0.8),maxLife:0.8,
        color:bloodColor(),size:rnd(1.5,3),gravity:300,blood:true,drag:0.96});
    }
    e.x=cl(e.x,e.r+4,W-e.r-4);
    if(e.type==='grunt'||e.type==='sniper'||e.type==='tank'){
      e.fireCd-=dt;
      if(e.fireCd<=0&&e.y>20&&e.y<H*0.85){
        e.fireCd=e.type==='tank'?2.3:(e.type==='sniper'?2.5:1.9);
        enemyShoot(e);
      }
    }
    if(e.y>H+120) enemies.splice(i,1);
  }
}
function killEnemy(index,silent){
  var e=enemies[index];
  if(!e) return;
  var gained=Math.floor(e.score*combo.multiplier);
  G.score+=gained;
  addCombo();
  G.killsThisRun++;
  saveData.totalKills=(saveData.totalKills||0)+1;
  var intensity=e.type==='tank'?2.2:(e.type==='sniper'?1.5:1.2);
  addBloodBurst(e.x,e.y,intensity,{upBias:true});
  addBloodDecal(e.x,e.y,e.r*1.3,{flat:true,persist:e.type==='tank'});
  G.killFlash=Math.max(G.killFlash,0.25);
  for(var i=0;i<10;i++) addParticle(e.x,e.y,
    ['#ff6b6b','#ffd166','#ff9f1c'][Math.floor(Math.random()*3)],0.9);
  var baseHeal=KILL_HEAL[e.type]||3;
  var comboBonus=1+Math.min(combo.multiplier-1,2)*0.25;
  healPlayer(Math.round(baseHeal*comboBonus),e.x,e.y);
  var dropChance=e.type==='tank'?0.5:0.2;
  if(Math.random()<dropChance) spawnPickup(e.x,e.y);
  if(!silent) sfx(140,0.14,'sawtooth',0.04);
  P.ultiCharge=Math.min(1,P.ultiCharge+0.02);
  P.ulti2Charge=Math.min(1,P.ulti2Charge+0.03);
  if(R){R.ultiCharge=Math.min(1,R.ultiCharge+0.02);R.ulti2Charge=Math.min(1,R.ulti2Charge+0.03)}
  enemies.splice(index,1);
}

