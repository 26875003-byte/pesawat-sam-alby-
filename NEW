    ctx.strokeStyle='rgba(255,255,255,0.5)';ctx.lineWidth=1;
    roundRect(ctx,bx+0.5,by+0.5,bw-1,bh-1,4);ctx.stroke();
    for(var m=1;m<10;m++){
      ctx.fillStyle='rgba(255,255,255,0.2)';
      ctx.fillRect(bx+bw*m/10,by,1,bh);
    }
    ctx.fillStyle='#fff';ctx.font='bold 13px Segoe UI, Arial';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.shadowBlur=8;ctx.shadowColor='#ff0054';
    ctx.fillText('BOSS '+boss.idx+' / '+MAX_BOSS+'   —   '+
      Math.ceil(Math.max(0,boss.hp)).toLocaleString('id-ID')+' HP',W/2,by+bh/2+1);
    ctx.restore();
  }
}

