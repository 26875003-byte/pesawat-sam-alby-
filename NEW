    var cw2=Math.min(220,(W-60)/n-14),ch2=Math.min(240,H*0.44);
    var totalW=n*cw2+(n-1)*14,startX=(W-totalW)/2,y2=H/2-ch2/2+20;
    for(var j=0;j<n;j++) rects.push({x:startX+j*(cw2+14),y:y2,w:cw2,h:ch2});
  }
  return rects;
}
