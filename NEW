      b.fireTimer=0.12;break;
    }
    case 3:{
      var n2=14+Math.min(14,Math.floor(idx/8));
      var off=Math.random()*TAU;
      for(var i=0;i<n2;i++){var a4=off+(i/n2)*TAU;
        spawnEBullet(b.x,b.y,Math.cos(a4)*spd*0.85,Math.sin(a4)*spd*0.85,8,'#4cc9f0')}
      b.fireTimer=1.35;sfx(150,0.2,'sawtooth',0.04);break;
    }
    case 4:{
      var n3=2+Math.min(3,Math.floor(idx/30));
      for(var i=0;i<n3;i++){var a5=aim+(i-(n3-1)/2)*0.9;
        spawnEBullet(b.x,b.y,Math.cos(a5)*150,Math.sin(a5)*150,9,'#ff9f1c',
          {homing:1.6+Math.min(idx*0.012,1.2),life:7})}
      b.fireTimer=1.5;sfx(260,0.2,'sawtooth',0.035);break;
    }
    case 5:{
      var n4=Math.max(6,Math.floor(W/70));
      var gap=Math.floor(Math.random()*n4);
      for(var i=0;i<n4;i++){
        if(i===gap||i===gap+1) continue;
