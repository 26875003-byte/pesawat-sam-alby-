      }
      b.fireTimer=1.55;sfx(120,0.22,'square',0.035);break;
    }
    case 6:{
      spawnEBullet(ox,oy,Math.cos(aim)*spd*1.7,Math.sin(aim)*spd*1.7,6,'#ffd166');
      spawnEBullet(b.x-b.r*0.55,oy,Math.cos(aim)*spd*1.7,Math.sin(aim)*spd*1.7,6,'#ffd166');
      spawnEBullet(b.x+b.r*0.55,oy,Math.cos(aim)*spd*1.7,Math.sin(aim)*spd*1.7,6,'#ffd166');
      b.fireTimer=0.28;break;
    }
    case 7:{
      var n5=4+Math.min(4,Math.floor(idx/20));
      for(var i=0;i<n5;i++){var a7=Math.PI/2+(i-(n5-1)/2)*0.32;
        spawnEBullet(ox,oy,Math.cos(a7)*spd*0.8,Math.sin(a7)*spd*0.8,7,'#06d6a0',
          {wobAmp:150,wobFreq:7})}
      b.fireTimer=0.8;break;
    }
    case 8:{
      for(var i=-2;i<=2;i++){var a8=Math.PI/2+i*0.26;
        spawnEBullet(ox,oy,Math.cos(a8)*spd*0.9,Math.sin(a8)*spd*0.9,7,'#f72585')}
      spawnEBullet(b.x,b.y,Math.cos(aim)*spd*1.4,Math.sin(aim)*spd*1.4,10,'#ffd166');
      b.fireTimer=0.85;break;
    }
    default:{
      var a9=aim+rnd(-0.18,0.18);
      spawnEBullet(b.x,b.y,Math.cos(a9)*spd*1.15,Math.sin(a9)*spd*1.15,16,'#ff0054',{big:true});
      b.fireTimer=0.95;sfx(90,0.25,'sawtooth',0.045);break;
    }
  }
