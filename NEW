    var previewBob=Math.sin(G.time*2+i)*3;
    drawShipPreview(r.x+r.w/2,previewCY+previewBob,i,previewScale,G.time);
    ctx.fillStyle=ship.color;
    ctx.font='bold '+Math.min(18,r.w*0.10)+'px Segoe UI, Arial';
    ctx.fillText(ship.name,r.x+r.w/2,r.y+r.h*0.52);
    ctx.fillStyle='#9bb3c9';
    ctx.font=Math.min(12,r.w*0.068)+'px Segoe UI, Arial';
    ctx.fillText(ship.desc,r.x+r.w/2,r.y+r.h*0.52+18);
    var statVals=[ship.stats.hp,ship.stats.spd,ship.stats.dmg,ship.stats.rate];
    var barStartY=r.y+r.h*0.70;
    var rowH=isDesktop?17:14;
    var barLeft=r.x+Math.max(30,r.w*0.24);
    var barW=r.w-(barLeft-r.x)-16;
    var segW=(barW-4*3)/5;
    for(var k=0;k<4;k++){
