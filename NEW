var BOSS_PATTERNS=10;
function createBoss(idx){
  var hpMult=isOnline?1.6:1;
  var hp=(400+idx*180+idx*idx*7)*hpMult;
  var r=70+Math.min(idx*0.7,60);
  return{idx:idx,x:W/2,y:-r-30,r:r,hp:hp,maxHp:hp,t:0,hitFlash:0,
    entering:true,targetY:150,
    moveSpeed:0.55+Math.min(idx*0.006,0.7),
    pattern:(idx-1)%BOSS_PATTERNS,patTimer:5,fireTimer:1.4,
    angle:Math.random()*TAU,moveAmp:Math.min(W*0.30,240),spin:0,
    eyeAngle:0,pulse:0};
}
function spawnEBullet(x,y,vx,vy,r,color,opts){
  if(ebullets.length>900) return;
  var b={x:x,y:y,vx:vx,vy:vy,r:r||6,color:color||'#ff4d6d',
    homing:0,wobAmp:0,wobFreq:0,phase:0,life:9,big:false};
  if(opts) Object.assign(b,opts);
  ebullets.push(b);
}
function updateBoss(dt){
  if(!boss) return;
  var b=boss;
  b.t+=dt;b.spin+=dt*1.1;b.pulse+=dt*3;
  if(b.hitFlash>0) b.hitFlash-=dt;
  b.eyeAngle=Math.atan2(P.y-b.y,P.x-b.x);
  if(!b.entering&&b.hp<b.maxHp*0.6&&Math.random()<0.2&&settings.bloodEffects){
    particles.push({x:b.x+rnd(-b.r*0.5,b.r*0.5),y:b.y+b.r*0.5,
      vx:rnd(-40,40),vy:rnd(50,130),life:rnd(0.6,1.2),maxLife:1.2,
      color:bloodColor(),size:rnd(2,4.5),gravity:380,blood:true,drag:0.95});
  }
  if(b.entering){
    b.y+=(b.targetY-b.y)*Math.min(1,dt*3.2);
    b.x+=(W/2-b.x)*Math.min(1,dt*4);
    if(Math.abs(b.y-b.targetY)<3){b.y=b.targetY;b.entering=false}
    return;
  }
  b.x=W/2+Math.sin(b.t*b.moveSpeed)*b.moveAmp;
  b.y=b.targetY+Math.sin(b.t*1.35)*24;
  b.x=cl(b.x,b.r+10,W-b.r-10);
  b.patTimer-=dt;
  if(b.patTimer<=0){
    b.patTimer=rnd(3.5,6);
    b.pattern=(b.pattern+1+Math.floor(Math.random()*3))%BOSS_PATTERNS;
    b.fireTimer=0.45;
  }
  b.fireTimer-=dt;
  if(b.fireTimer<=0) bossAttack(b);
}
function bossAttack(b){
