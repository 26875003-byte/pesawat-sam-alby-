/* ═══════ ACHIEVEMENTS CHECK ═══════ */
function checkAchievements(run){
  var unlocked=0;
  for(var i=0;i<ACHIEVEMENTS.length;i++){
    var ach=ACHIEVEMENTS[i];
    if(saveData.achievements[ach.id]) continue;
    try{
      if(ach.check(saveData,run)){
        saveData.achievements[ach.id]={unlockedAt:Date.now()};
        unlocked++;
        showMsg('🏆 '+ach.name+'!',2.5);
        addKillFeed('🏆 '+ach.name,'#ffd166');
        sfx(880,0.15,'sine',0.08);
      }
    }catch(e){}
  }
  if(unlocked>0) persistSave();
  return unlocked;
}

