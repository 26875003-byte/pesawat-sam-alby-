function drawButton(b,color,colorText){
  ctx.save();
  var rad=12;
  /* Shadow */
  ctx.shadowBlur=8;ctx.shadowColor='rgba(0,0,0,0.5)';ctx.shadowOffsetY=2;
  var grad=ctx.createLinearGradient(b.x,b.y,b.x,b.y+b.h);
  grad.addColorStop(0,color);
  grad.addColorStop(1,colorText+'22');
  ctx.fillStyle=grad;
  roundRect(ctx,b.x,b.y,b.w,b.h,rad);ctx.fill();
  ctx.shadowBlur=0;ctx.shadowOffsetY=0;
  ctx.strokeStyle=colorText;ctx.lineWidth=2;
  roundRect(ctx,b.x,b.y,b.w,b.h,rad);ctx.stroke();
  ctx.fillStyle=colorText;
  ctx.font='bold 16px Segoe UI, Arial';
  ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillText(b.label,b.x+b.w/2,b.y+b.h/2+1);
  ctx.restore();
}

