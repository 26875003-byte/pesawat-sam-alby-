function drawLowHpWarning(){
  if(G.state!=='playing') return;
  var hpRatio=P.hp/P.maxHp;
  if(hpRatio>0.3||P.dead) return;
  var pulse=0.5+Math.sin(G.time*8)*0.5;
  var intensity=(1-hpRatio/0.3)*pulse;
  ctx.save();
  var g=ctx.createRadialGradient(W/2,H/2,Math.min(W,H)*0.3,W/2,H/2,Math.max(W,H)*0.72);
  g.addColorStop(0,'rgba(255,0,50,0)');
  g.addColorStop(1,'rgba(255,0,50,'+(intensity*0.55)+')');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  ctx.restore();
}
function drawFloatingTexts(){
  if(floatingTexts.length===0) return;
  ctx.save();
  ctx.textAlign='center';ctx.textBaseline='middle';
  for(var i=0;i<floatingTexts.length;i++){
    var f=floatingTexts[i];
    var a=Math.min(1,f.life/0.4);
    ctx.globalAlpha=a;
    ctx.font='bold 20px Segoe UI, Arial';
    ctx.shadowBlur=10;ctx.shadowColor=f.color;
    ctx.fillStyle=f.color;
    ctx.fillText(f.text,f.x,f.y);
    ctx.shadowBlur=0;
  }
  ctx.restore();
  ctx.globalAlpha=1;
}
function drawKillFeed(){
  if(G.killFeed.length===0) return;
  ctx.save();
  ctx.textAlign='right';ctx.textBaseline='middle';
  ctx.font='bold 12px Segoe UI, Arial';
  for(var i=0;i<G.killFeed.length;i++){
    var k=G.killFeed[i];
    var a=Math.min(1,k.life/0.8);
    ctx.globalAlpha=a;
    ctx.shadowBlur=8;ctx.shadowColor=k.color;
    ctx.fillStyle=k.color;
    ctx.fillText(k.text,W-20,120+i*20);
    ctx.shadowBlur=0;
  }
  ctx.restore();
  ctx.globalAlpha=1;
}
function drawPickups(){
  for(var i=0;i<pickups.length;i++){
    var p=pickups[i];
    var info=PICKUPS[p.type];
    if(!info) continue;
    var pulse=0.6+Math.sin(p.bob)*0.4;
    var bobY=Math.sin(p.bob)*4;
    ctx.save();
    ctx.translate(p.x,p.y+bobY);
    var glowR=24+pulse*6;
    var g=ctx.createRadialGradient(0,0,0,0,0,glowR);
    g.addColorStop(0,info.color+'AA');
    g.addColorStop(1,info.color+'00');
    ctx.fillStyle=g;
    ctx.beginPath();ctx.arc(0,0,glowR,0,TAU);ctx.fill();
    ctx.strokeStyle=info.color;ctx.lineWidth=2.5;
    ctx.beginPath();ctx.arc(0,0,16,0,TAU);ctx.stroke();
    ctx.fillStyle='rgba(10,16,36,0.95)';
    ctx.beginPath();ctx.arc(0,0,14,0,TAU);ctx.fill();
    ctx.fillStyle=info.color;
    ctx.font='bold 16px Segoe UI, Arial';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(info.icon,0,1);
    ctx.restore();
  }
}
function drawShipBody(type,flash,col,col2){
  if(flash){
    ctx.shadowBlur=20;ctx.shadowColor='#fff';
  }
  switch(type){
    case 0:
      ctx.fillStyle=flash?'#ffffff':col2;
      ctx.beginPath();ctx.moveTo(-6,-4);ctx.lineTo(-20,12);ctx.lineTo(-6,10);ctx.closePath();ctx.fill();
      ctx.beginPath();ctx.moveTo(6,-4);ctx.lineTo(20,12);ctx.lineTo(6,10);ctx.closePath();ctx.fill();
      var cg=ctx.createLinearGradient(0,-22,0,13);
      cg.addColorStop(0,flash?'#ffffff':col);
      cg.addColorStop(1,flash?'#ffffff':col2);
      ctx.fillStyle=cg;
      ctx.beginPath();ctx.moveTo(0,-22);ctx.lineTo(10,6);ctx.lineTo(0,13);ctx.lineTo(-10,6);ctx.closePath();ctx.fill();
      ctx.fillStyle='#0b2b3a';
      ctx.beginPath();ctx.ellipse(0,-4,3.6,7,0,0,TAU);ctx.fill();
      ctx.fillStyle=flash?'#fff':col;
      ctx.beginPath();ctx.ellipse(0,-4,2,4,0,0,TAU);ctx.fill();
      break;
    case 1:
      ctx.fillStyle=flash?'#ffffff':col2;
      ctx.beginPath();ctx.moveTo(-10,-2);ctx.lineTo(-26,8);ctx.lineTo(-22,16);ctx.lineTo(-8,12);ctx.closePath();ctx.fill();
      ctx.beginPath();ctx.moveTo(10,-2);ctx.lineTo(26,8);ctx.lineTo(22,16);ctx.lineTo(8,12);ctx.closePath();ctx.fill();
      var cg2=ctx.createLinearGradient(0,-20,0,16);
      cg2.addColorStop(0,flash?'#ffffff':col);
      cg2.addColorStop(1,flash?'#ffffff':col2);
      ctx.fillStyle=cg2;
      ctx.beginPath();ctx.moveTo(0,-20);ctx.lineTo(12,-6);ctx.lineTo(12,10);ctx.lineTo(0,16);
      ctx.lineTo(-12,10);ctx.lineTo(-12,-6);ctx.closePath();ctx.fill();
      ctx.fillStyle='#0b2b3a';
      ctx.beginPath();ctx.ellipse(0,-3,5,8,0,0,TAU);ctx.fill();
      ctx.fillStyle=flash?'#fff':col;
      ctx.beginPath();ctx.ellipse(0,-3,3,5,0,0,TAU);ctx.fill();
      break;
    case 2:
      ctx.fillStyle=flash?'#ffffff':col2;
      ctx.beginPath();ctx.moveTo(-3,0);ctx.lineTo(-14,10);ctx.lineTo(-3,8);ctx.closePath();ctx.fill();
      ctx.beginPath();ctx.moveTo(3,0);ctx.lineTo(14,10);ctx.lineTo(3,8);ctx.closePath();ctx.fill();
      var cg3=ctx.createLinearGradient(0,-26,0,12);
      cg3.addColorStop(0,flash?'#ffffff':col);
      cg3.addColorStop(1,flash?'#ffffff':col2);
      ctx.fillStyle=cg3;
      ctx.beginPath();ctx.moveTo(0,-26);ctx.lineTo(6,4);ctx.lineTo(0,12);ctx.lineTo(-6,4);ctx.closePath();ctx.fill();
      ctx.fillStyle='#0b2b3a';
      ctx.beginPath();ctx.ellipse(0,-6,2.5,6,0,0,TAU);ctx.fill();
      break;
    case 3:
      ctx.fillStyle=flash?'#ffffff':col2;
      ctx.beginPath();ctx.moveTo(-4,-8);ctx.lineTo(-20,-2);ctx.lineTo(-18,10);ctx.lineTo(-4,4);ctx.closePath();ctx.fill();
      ctx.beginPath();ctx.moveTo(4,-8);ctx.lineTo(20,-2);ctx.lineTo(18,10);ctx.lineTo(4,4);ctx.closePath();ctx.fill();
      var cg4=ctx.createLinearGradient(0,-24,0,14);
      cg4.addColorStop(0,flash?'#ffffff':col);
      cg4.addColorStop(1,flash?'#ffffff':col2);
      ctx.fillStyle=cg4;
      ctx.beginPath();ctx.moveTo(0,-24);ctx.lineTo(8,-2);ctx.lineTo(6,12);ctx.lineTo(0,14);
      ctx.lineTo(-6,12);ctx.lineTo(-8,-2);ctx.closePath();ctx.fill();
      ctx.fillStyle='#0b2b3a';
      ctx.beginPath();ctx.ellipse(0,-4,3,7,0,0,TAU);ctx.fill();
      break;
    case 4:
      ctx.fillStyle=flash?'#ffffff':col2;
      ctx.beginPath();
      ctx.moveTo(-10,-8);ctx.lineTo(-22,2);ctx.lineTo(-18,12);ctx.lineTo(-4,6);
      ctx.closePath();ctx.fill();
      ctx.beginPath();
      ctx.moveTo(10,-8);ctx.lineTo(22,2);ctx.lineTo(18,12);ctx.lineTo(4,6);
      ctx.closePath();ctx.fill();
      var cg5=ctx.createLinearGradient(0,-26,0,14);
      cg5.addColorStop(0,flash?'#ffffff':col);
      cg5.addColorStop(1,flash?'#ffffff':col2);
      ctx.fillStyle=cg5;
      ctx.beginPath();
      ctx.moveTo(0,-26);ctx.lineTo(6,-4);ctx.lineTo(4,10);ctx.lineTo(0,14);
      ctx.lineTo(-4,10);ctx.lineTo(-6,-4);ctx.closePath();ctx.fill();
      ctx.fillStyle='#0b2b3a';
      ctx.beginPath();ctx.ellipse(0,-6,2.8,6.5,0,0,TAU);ctx.fill();
      break;
  }
  if(flash) ctx.shadowBlur=0;
}
function drawShipPreview(px,py,type,scale,time){
