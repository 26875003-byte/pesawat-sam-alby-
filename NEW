/* ═══════ BULLETS ═══════ */
function fireFromPlayer(p,color){
  var owner=(p===P)?'P':'R';
  var w=buffs.weapon;
  var rapidMult=buffs.rapidFire>0?1.7:1;
  var face=p.faceDir||-1;
  var baseAngle=face>0?Math.PI/2:-Math.PI/2;
  var noseY=p.y+face*14;
  var baseY=p.y+face*10;

  p.firing=Math.max(p.firing,0.15);

  if(w==='LASER'){
    pbullets.push({x:p.x,y:noseY,vx:0,vy:face*1400,
      r:6,dmg:p.dmg*3.2,color:'#ff0054',
      pierce:3,hitSet:new Set(),laser:true,owner:owner,face:face});
  }else if(w==='SPREAD'){
    var n=8;
    for(var i=0;i<n;i++){
      var a=baseAngle+(i-(n-1)/2)*0.16;
      pbullets.push({x:p.x,y:baseY,
        vx:Math.cos(a)*850,vy:Math.sin(a)*850,
        r:4,dmg:p.dmg*0.6,color:'#ffd166',
        pierce:0,hitSet:null,owner:owner,face:face});
    }
  }else if(w==='HOMING'){
    var n2=2;
    for(var j=0;j<n2;j++){
      var off=j-(n2-1)/2;
      pbullets.push({x:p.x+off*12,y:baseY,
        vx:Math.cos(baseAngle+off*0.3)*400,
        vy:Math.sin(baseAngle+off*0.3)*400,
        r:5,dmg:p.dmg*1.8,color:'#06d6a0',
        pierce:0,hitSet:null,homing:4.5,owner:owner,face:face});
    }
  }else{
    var n3=p.streams;
    var spread=0.075;
    for(var k=0;k<n3;k++){
      var off2=k-(n3-1)/2;
      var ang=baseAngle+off2*spread;
      pbullets.push({x:p.x+off2*9,y:noseY,
        vx:Math.cos(ang)*950*rapidMult,vy:Math.sin(ang)*950*rapidMult,
        r:4,dmg:p.dmg,color:color||'#7bdff2',
        pierce:p.pierce,hitSet:p.pierce>0?new Set():null,owner:owner,face:face});
    }
  }
}
function updateBullets(dt){
  for(var i=pbullets.length-1;i>=0;i--){
    var b=pbullets[i];
    if(b.homing){
      var bestT=null,bestD=999999;
      for(var j=0;j<enemies.length;j++){
        var e=enemies[j];
        var d=d2(b.x,b.y,e.x,e.y);
        if(d<bestD){bestD=d;bestT=e}
      }
      if(G.gameMode==='pvp'){
        var opp=(b.owner==='P')?R:P;
        if(opp&&!opp.dead){
          var d2b=d2(b.x,b.y,opp.x,opp.y);
          if(d2b<bestD){bestD=d2b;bestT=opp}
        }
      }
      if(boss&&!boss.entering){
        var d3=d2(b.x,b.y,boss.x,boss.y);
        if(d3<bestD){bestD=d3;bestT=boss}
      }
      if(bestT){
        var a=Math.atan2(bestT.y-b.y,bestT.x-b.x);
        var ca=Math.atan2(b.vy,b.vx);
        var da=a-ca;
        while(da>Math.PI) da-=TAU;
        while(da<-Math.PI) da+=TAU;
        var turn=Math.sign(da)*Math.min(Math.abs(da),b.homing*dt);
        var na=ca+turn;
        var spd=Math.min(1200,Math.hypot(b.vx,b.vy)+400*dt);
        b.vx=Math.cos(na)*spd;b.vy=Math.sin(na)*spd;
      }
    }
    b.x+=b.vx*dt;b.y+=b.vy*dt;
    if(b.y<-30||b.y>H+30||b.x<-40||b.x>W+40) pbullets.splice(i,1);
  }
  for(var i2=ebullets.length-1;i2>=0;i2--){
    var b2=ebullets[i2];
    if(b2.homing){
      var tgt=nearestPlayer(b2.x,b2.y);
      var a2=Math.atan2(tgt.y-b2.y,tgt.x-b2.x);
      var ca2=Math.atan2(b2.vy,b2.vx);
      var da2=a2-ca2;
      while(da2>Math.PI) da2-=TAU;
      while(da2<-Math.PI) da2+=TAU;
      var turn2=Math.sign(da2)*Math.min(Math.abs(da2),b2.homing*dt);
      var na2=ca2+turn2;
      var s2=Math.hypot(b2.vx,b2.vy);
      b2.vx=Math.cos(na2)*s2;b2.vy=Math.sin(na2)*s2;
    }
    b2.x+=b2.vx*dt;b2.y+=b2.vy*dt;
    if(b2.wobAmp){
      b2.phase+=dt*b2.wobFreq;
      var px=-b2.vy,py=b2.vx,len=Math.hypot(px,py)||1;
      b2.x+=(px/len)*Math.cos(b2.phase)*b2.wobAmp*dt;
      b2.y+=(py/len)*Math.cos(b2.phase)*b2.wobAmp*dt;
    }
    b2.life-=dt;
    if(b2.life<=0||b2.y>H+60||b2.y<-120||b2.x<-80||b2.x>W+80) ebullets.splice(i2,1);
  }
}

/* ═══════ PARTICLES ═══════ */
function addParticle(x,y,color,size){
  if(particles.length>700) return;
  var a=Math.random()*TAU,s=rnd(40,260);
  particles.push({x:x,y:y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,
    life:rnd(0.28,0.75),maxLife:0.75,color:color,
    size:(size||1)*rnd(1.4,3.4),drag:0.94});
}
function updateParticles(dt){
  for(var i=particles.length-1;i>=0;i--){
    var p=particles[i];
    if(p.gravity) p.vy+=p.gravity*dt;
    p.x+=p.vx*dt;p.y+=p.vy*dt;
    var d=p.drag||0.94;
    p.vx*=d;p.vy*=d;
    p.life-=dt;
    if(p.life<=0||p.y>H+50) particles.splice(i,1);
  }
}
function updateBloodDecals(dt){
  for(var i=bloodDecals.length-1;i>=0;i--){
    bloodDecals[i].life-=dt;
    if(bloodDecals[i].life<=0) bloodDecals.splice(i,1);
  }
}
function updateBloodDrips(dt){
  for(var i=bloodDrips.length-1;i>=0;i--){
    var d=bloodDrips[i];
    d.y+=d.vy*dt;d.wobble+=dt*d.wobbleSpd;d.life-=dt;
    if(d.life<=0||d.y>H+40) bloodDrips.splice(i,1);
  }
}
function updateFloatingTexts(dt){
  for(var i=floatingTexts.length-1;i>=0;i--){
    var f=floatingTexts[i];
    f.y+=f.vy*dt;f.vy*=0.95;f.life-=dt;
    if(f.life<=0) floatingTexts.splice(i,1);
  }
}
function updateKillFeed(dt){
  for(var i=G.killFeed.length-1;i>=0;i--){
    G.killFeed[i].life-=dt;
    if(G.killFeed[i].life<=0) G.killFeed.splice(i,1);
  }
}

/* ═══════ COLLISIONS ═══════ */
function collisions(){
  for(var i=pbullets.length-1;i>=0;i--){
    var b=pbullets[i];
    var hit=false;
    if(G.gameMode==='pvp'){
      if(b.owner==='P'&&R&&!R.dead&&R.invuln<=0&&d2(b.x,b.y,R.x,R.y)<(R.r+b.r)*(R.r+b.r)){
        damagePlayer(R,b.dmg);
        addBloodBurst(b.x,b.y,0.6,{upBias:true});
        pbullets.splice(i,1);continue;
      }
      if(b.owner==='R'&&!P.dead&&P.invuln<=0&&d2(b.x,b.y,P.x,P.y)<(P.r+b.r)*(P.r+b.r)){
        damagePlayer(P,b.dmg);
        addBloodBurst(b.x,b.y,0.6,{upBias:true});
        pbullets.splice(i,1);continue;
      }
      continue;
    }
    if(boss&&d2(b.x,b.y,boss.x,boss.y)<(boss.r+b.r)*(boss.r+b.r)){
      boss.hp-=b.dmg;boss.hitFlash=0.09;
      addParticle(b.x,b.y,'#ffd166',0.8);
      if(Math.random()<0.4) addBloodBurst(b.x,b.y,0.35);
      hit=true;
      if(boss.hp<=0) bossDefeated();
    }
    if(!hit){
      for(var j=enemies.length-1;j>=0;j--){
        var e=enemies[j];
        if(b.hitSet&&b.hitSet.has(e)) continue;
        if(d2(b.x,b.y,e.x,e.y)<(e.r+b.r)*(e.r+b.r)){
          e.hp-=b.dmg;e.hitFlash=0.09;
          if(e.hp>0) addBloodBurst(b.x,b.y,0.4);
          if(b.hitSet) b.hitSet.add(e);
          if(e.hp<=0) killEnemy(j);
          if(b.pierce>0) b.pierce--;else hit=true;
          break;
        }
      }
    }
    if(hit) pbullets.splice(i,1);
  }
  if(G.state!=='playing') return;
  if(G.gameMode==='pvp') return;
  checkPlayerCollisions(P);
  if(R) checkPlayerCollisions(R);
}
function checkPlayerCollisions(pl){
  if(pl.dead||pl.invuln>0) return;
  for(var i=ebullets.length-1;i>=0;i--){
    var b=ebullets[i];
    if(d2(b.x,b.y,pl.x,pl.y)<(b.r+pl.r)*(b.r+pl.r)){
      ebullets.splice(i,1);
      damagePlayer(pl,b.big?22:10);
      return;
    }
  }
  for(var j=enemies.length-1;j>=0;j--){
    var e=enemies[j];
    if(d2(e.x,e.y,pl.x,pl.y)<(e.r+pl.r)*(e.r+pl.r)){
      e.hp-=30;
      if(e.hp<=0) killEnemy(j);
      damagePlayer(pl,16);
      return;
    }
  }
  if(boss&&!boss.entering&&d2(boss.x,boss.y,pl.x,pl.y)<(boss.r+pl.r)*(boss.r+pl.r)){
    damagePlayer(pl,24);
  }
}
function damagePlayer(pl,amount){
  if(pl===P&&buffs.shield>0){
    var absorbed=Math.min(buffs.shield,amount);
    buffs.shield-=absorbed;
    amount-=absorbed;
    addParticle(pl.x,pl.y,'#4cc9f0',1.5);
    sfx(600,0.1,'sine',0.05);
    if(amount<=0){pl.invuln=0.5;return}
  }
  pl.hp-=amount;
  pl.invuln=0.5;
  pl.hitFlash=0.25;
  if(settings.screenShake) G.shake=Math.max(G.shake,0.65);
  if(pl===P) G.damageFlash=Math.min(1,G.damageFlash+0.3);
  addParticle(pl.x,pl.y,'#ff4d6d',2);
  if(pl===P){
    addBloodBurst(pl.x,pl.y,0.8,{upBias:true});
    if(settings.bloodEffects) G.screenBlood=Math.min(1,G.screenBlood+0.55);
    var dripN=amount>15?3:1+Math.floor(Math.random()*2);
    for(var i=0;i<dripN;i++) addBloodDrip();
  }
  sfx(110,0.22,'sawtooth',0.06);
  if(pl.hp<=0){
    pl.hp=0;
    addBloodBurst(pl.x,pl.y,3,{upBias:true});
    addBloodDecal(pl.x,pl.y,pl.r*1.8,{flat:true,persist:true,alpha:0.85});
    if(settings.bloodEffects) G.screenBlood=1;
    if(settings.screenShake) G.shake=1.2;
    if(pl===P){
      G.runDeaths++;
      saveData.totalDeaths=(saveData.totalDeaths||0)+1;
    }
    if(G.gameMode==='pvp'){
      pl.dead=true;
    }else if(G.gameMode==='bossrush'){
      if(pl===P){
        G.state='bossrushEnd';
        checkAchievements({deaths:G.runDeaths,level:G.level,bossesKilled:G.bossRushIdx,
          bestCombo:combo.bestCombo,ultisUsed:G.runUltisUsed,beamsUsed:G.runBeamsUsed});
        if(G.bossRushIdx>(saveData.bossRushBest||0)){
          saveData.bossRushBest=G.bossRushIdx;
          addToLeaderboard({score:G.score,level:G.bossRushIdx,bosses:G.bossRushIdx,mode:'bossrush'});
        }
        persistSave();
      }
    }else if(isOnline&&isHost){
      pl.dead=true;
      pl.respawnTimer=2.5;
      for(var k=0;k<50;k++) addParticle(pl.x,pl.y,'#7bdff2',1.6);
      if(settings.screenShake) G.shake=1.0;
      if((pl===P&&R&&R.dead)||(pl===R&&P.dead)){
        G.state='gameover';
        if(conn&&conn.open) conn.send({t:'gameover'});
      }
    }else if(isOnline&&!isHost){
    }else{
      G.state='gameover';
      for(var k2=0;k2<50;k2++) addParticle(pl.x,pl.y,'#7bdff2',1.6);
    }
  }
}
function checkPvpEnd(){
  if(G.gameMode!=='pvp'||!isOnline||!isHost) return;
  if(G.state!=='playing') return;
  if(!R) return;
  if(P.dead&&!R.dead){
    G.state='pvpLose';
    if(conn&&conn.open) conn.send({t:'pvpEnd',hostWon:false});
  }else if(R.dead&&!P.dead){
    G.state='pvpWin';
    saveData.pvpWins=(saveData.pvpWins||0)+1;
    checkAchievements({});
    persistSave();
    if(conn&&conn.open) conn.send({t:'pvpEnd',hostWon:true});
  }else if(P.dead&&R.dead){
    G.state='pvpDraw';
    if(conn&&conn.open) conn.send({t:'pvpEnd',draw:true});
  }
}

/* ═══════ UPDATE PLAYER ═══════ */
function updatePlayer(p,dt,isLocal){
  if(p.dead){
    if(G.gameMode!=='pvp'&&G.gameMode!=='bossrush'){
      p.respawnTimer-=dt;
      if(p.respawnTimer<=0){
        p.dead=false;p.hp=p.maxHp*0.5;p.invuln=2;
        p.x=W/2+(p===R?-80:80);p.y=H-120;
        p.faceDir=-1;
      }
    }
    return;
  }
  var dx=0,dy=0;
  if(isLocal){
    if(keys['arrowleft']||keys['a']) dx-=1;
    if(keys['arrowright']||keys['d']) dx+=1;
    if(keys['arrowup']||keys['w']) dy-=1;
    if(keys['arrowdown']||keys['s']) dy+=1;
  }
  if(dx||dy){
    var l=Math.hypot(dx,dy);
    p.x+=(dx/l)*p.speed*dt;p.y+=(dy/l)*p.speed*dt;
    if(isLocal&&dragging){targetX=p.x;targetY=p.y}
  }
  if(isLocal&&dragging){
    var k=Math.min(1,dt*20);
    p.x+=(targetX-p.x)*k;p.y+=(targetY-p.y)*k;
  }
  p.x=cl(p.x,p.r+6,W-p.r-6);
  p.y=cl(p.y,p.r+50,H-p.r-6);
  if(p.invuln>0) p.invuln-=dt;
  if(p.hitFlash>0) p.hitFlash-=dt;
  if(p.ultiActive>0) p.ultiActive-=dt;
  if(p.ulti2Active>0) p.ulti2Active-=dt;
  if(p.firing>0) p.firing-=dt;
  if(p.ulti2Beam){p.ulti2Beam.x=p.x}
  if(p.ultiCharge<1) p.ultiCharge=Math.min(1,p.ultiCharge+dt*p.ultiRate/16);
  if(p.ulti2Charge<1) p.ulti2Charge=Math.min(1,p.ulti2Charge+dt*p.ulti2Rate/22);

  p.cd-=dt;
  if(p.cd<=0){
    var rateMult=(isLocal&&buffs.rapidFire>0)?0.5:1;
    var attackHeldNow=(isLocal&&attackHeld)||(!isLocal&&netRemoteAttackHeld);
    var attackMult=attackHeldNow?0.35:1;
    p.cd=p.fireRate*rateMult*attackMult;
    var col=SHIPS[p===P?G.selectedShip:remoteShip].color;
    fireFromPlayer(p,col);
  }
}
function updateGuest(dt){
  if(P.dead) return;
  var dx=0,dy=0;
  if(keys['arrowleft']||keys['a']) dx-=1;
  if(keys['arrowright']||keys['d']) dx+=1;
  if(keys['arrowup']||keys['w']) dy-=1;
  if(keys['arrowdown']||keys['s']) dy+=1;
  if(dx||dy){
    var l=Math.hypot(dx,dy);
    P.x+=(dx/l)*P.speed*dt;P.y+=(dy/l)*P.speed*dt;
    if(dragging){targetX=P.x;targetY=P.y}
  }
  if(dragging){
    var k=Math.min(1,dt*20);
    P.x+=(targetX-P.x)*k;P.y+=(targetY-P.y)*k;
  }
  P.x=cl(P.x,P.r+6,W-P.r-6);
  P.y=cl(P.y,P.r+50,H-P.r-6);
  if(P.ulti2Beam) P.ulti2Beam.x=P.x;
  net.inputTimer-=dt;
  if(net.inputTimer<=0&&conn&&conn.open){
    net.inputTimer=1/30;
    try{
      conn.send({t:'i',x:Math.round(P.x),y:Math.round(P.y),
        u:net.pendingUlti,u2:net.pendingUlti2,a:attackHeld?1:0});
      net.pendingUlti=false;net.pendingUlti2=false;
    }catch(e){}
  }
  if(P.ultiCharge<1) P.ultiCharge=Math.min(1,P.ultiCharge+dt*P.ultiRate/16);
  if(P.ulti2Charge<1) P.ulti2Charge=Math.min(1,P.ulti2Charge+dt*P.ulti2Rate/22);
  if(P.invuln>0) P.invuln-=dt;
  if(P.ultiActive>0) P.ultiActive-=dt;
  if(P.ulti2Active>0) P.ulti2Active-=dt;
}

function update(dt){
  var realDt=dt;
  if(G.slowMo>0&&settings.slowMotion){
    realDt=dt*(1-G.slowMo*0.65);
    G.slowMo=Math.max(0,G.slowMo-dt*1.5);
  }else if(G.slowMo>0){G.slowMo=0}

  G.fpsCounter++;
  G.fpsTimer+=dt;
  if(G.fpsTimer>=0.5){G.fps=Math.round(G.fpsCounter/G.fpsTimer);G.fpsCounter=0;G.fpsTimer=0}

  G.time+=realDt;
  if(G.shake>0) G.shake=Math.max(0,G.shake-realDt*2.6);
  if(G.flash>0) G.flash=Math.max(0,G.flash-realDt*2.2);
  if(G.msgT>0) G.msgT-=realDt;
  if(G.screenBlood>0) G.screenBlood=Math.max(0,G.screenBlood-realDt*1.6);
  if(G.killFlash>0) G.killFlash=Math.max(0,G.killFlash-realDt*3.5);
  if(G.healFlash>0) G.healFlash=Math.max(0,G.healFlash-realDt*2.5);
  if(G.damageFlash>0) G.damageFlash=Math.max(0,G.damageFlash-realDt*4);
  if(G.bossWarning>0) G.bossWarning=Math.max(0,G.bossWarning-realDt);
  if(buffs.rapidFire>0) buffs.rapidFire-=realDt;
  if(buffs.magnet>0) buffs.magnet-=realDt;
  if(buffs.weaponTimer>0){
    buffs.weaponTimer-=realDt;
    if(buffs.weaponTimer<=0) buffs.weapon='VULCAN';
  }

  /* Smooth HUD values */
  G.hudHp+=((P.hp/P.maxHp*100)-G.hudHp)*Math.min(1,realDt*8);
  G.hudShield+=(buffs.shield-G.hudShield)*Math.min(1,realDt*8);

  /* Stars parallax */
  for(var i=0;i<starsFar.length;i++){starsFar[i].y+=8*realDt;if(starsFar[i].y>H) starsFar[i].y=-4}
  for(var i=0;i<starsMid.length;i++){starsMid[i].y+=20*realDt;if(starsMid[i].y>H) starsMid[i].y=-4}
  for(var i=0;i<starsNear.length;i++){starsNear[i].y+=50*realDt;if(starsNear[i].y>H) starsNear[i].y=-4}

  updateParticles(realDt);
  updateBloodDecals(realDt);
  updateBloodDrips(realDt);
  updateFloatingTexts(realDt);
  updateCombo(realDt);
  updateKillFeed(realDt);

  if(G.state!=='playing') return;

  if(G.gameMode==='bossrush') G.bossRushTime+=realDt;
  if(isOnline&&!isHost){updateGuest(realDt);return}
  if(G.gameMode==='pvp') G.pvpTime+=realDt;

  updatePlayer(P,realDt,true);
  if(R) updatePlayer(R,realDt,false);
  if(P.ulti2Beam) updateUlti2Beam(P,realDt);
  if(R&&R.ulti2Beam) updateUlti2Beam(R,realDt);
  updateBullets(realDt);

  if(G.gameMode!=='pvp'){
    updateEnemies(realDt);
    updateBoss(realDt);
    updateLevel(realDt);
  }else{
    G.pvpPickupTimer-=realDt;
    if(G.pvpPickupTimer<=0){
      G.pvpPickupTimer=4+Math.random()*2;
      spawnPickup(rnd(80,W-80),rnd(120,H*0.6));
    }
  }
  updatePickups(realDt);
  collisions();
  checkPvpEnd();
  if(isOnline&&isHost){
    net.sendTimer-=realDt;
    if(net.sendTimer<=0){net.sendTimer=0.05;hostSendSnapshot()}
  }
}

/* ═══════ RENDERING ═══════ */
function drawNebulas(){
  for(var i=0;i<nebulas.length;i++){
    var n=nebulas[i];
    var g=ctx.createRadialGradient(n.x,n.y,0,n.x,n.y,n.r);
    g.addColorStop(0,'hsla('+n.hue+',70%,50%,'+n.a+')');
    g.addColorStop(1,'hsla('+n.hue+',70%,50%,0)');
    ctx.fillStyle=g;
    ctx.fillRect(0,0,W,H);
  }
}
function drawStars(){
  var i,s;
  for(i=0;i<starsFar.length;i++){s=starsFar[i];ctx.fillStyle='rgba(180,200,255,'+s.a+')';ctx.fillRect(s.x,s.y,s.s,s.s)}
  for(i=0;i<starsMid.length;i++){s=starsMid[i];ctx.fillStyle='rgba(200,220,255,'+(s.a+0.1)+')';ctx.fillRect(s.x,s.y,s.s,s.s)}
  for(i=0;i<starsNear.length;i++){s=starsNear[i];ctx.fillStyle='rgba(220,235,255,'+(s.a+0.2)+')';ctx.fillRect(s.x,s.y,s.s*1.5,s.s*1.5)}
}
function drawVignette(){
  var g=ctx.createRadialGradient(W/2,H/2,Math.min(W,H)*0.4,W/2,H/2,Math.max(W,H)*0.75);
  g.addColorStop(0,'rgba(0,0,0,0)');
  g.addColorStop(1,'rgba(0,0,0,0.55)');
  ctx.fillStyle=g;
  ctx.fillRect(0,0,W,H);
}
function drawScanlines(){
  ctx.save();
  ctx.globalAlpha=0.04;
  ctx.fillStyle='#000';
  for(var y=0;y<H;y+=3) ctx.fillRect(0,y,W,1);
  ctx.restore();
}
function drawDamageFlash(){
  if(G.damageFlash<=0) return;
  var a=G.damageFlash*0.35;
  var g=ctx.createRadialGradient(W/2,H/2,Math.min(W,H)*0.3,W/2,H/2,Math.max(W,H)*0.75);
  g.addColorStop(0,'rgba(255,0,50,0)');
  g.addColorStop(0.6,'rgba(255,0,50,'+a*0.6+')');
  g.addColorStop(1,'rgba(255,0,50,'+a+')');
  ctx.fillStyle=g;
  ctx.fillRect(0,0,W,H);
}
function drawBloodDecals(){
  if(bloodDecals.length===0) return;
  ctx.save();
  for(var i=0;i<bloodDecals.length;i++){
    var b=bloodDecals[i];
    var a=Math.min(1,b.life/b.maxLife)*b.alpha;
    ctx.globalAlpha=a;
    ctx.fillStyle='#6b0000';
    ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,TAU);ctx.fill();
    ctx.fillStyle='#8b0000';
    for(var j=0;j<b.splats.length;j++){
      var s=b.splats[j];
      ctx.beginPath();ctx.arc(b.x+s.dx,b.y+s.dy,s.r,0,TAU);ctx.fill();
    }
    ctx.fillStyle='rgba(180,0,30,0.4)';
    ctx.beginPath();ctx.arc(b.x,b.y,b.r*0.55,0,TAU);ctx.fill();
  }
  ctx.globalAlpha=1;
  ctx.restore();
}
function drawBloodDrips(){
  if(bloodDrips.length===0) return;
  ctx.save();
  for(var i=0;i<bloodDrips.length;i++){
    var d=bloodDrips[i];
    var alpha=Math.min(1,d.life/d.maxLife)*0.75;
    ctx.globalAlpha=alpha;
    var wobbleX=Math.sin(d.wobble)*3;
    ctx.fillStyle='#8b0000';
    ctx.beginPath();ctx.ellipse(d.x+wobbleX,d.y,d.w*0.6,d.len*0.5,0,0,TAU);ctx.fill();
    ctx.fillStyle='rgba(139,0,0,0.5)';
    ctx.beginPath();ctx.ellipse(d.x+wobbleX,d.y-d.len*0.6,d.w*0.35,d.len*0.4,0,0,TAU);ctx.fill();
    ctx.fillStyle='#c1001f';
    ctx.beginPath();ctx.arc(d.x+wobbleX,d.y+d.len*0.3,d.w*0.75,0,TAU);ctx.fill();
  }
  ctx.globalAlpha=1;
  ctx.restore();
}
function drawScreenBlood(){
