/* ═══════ MULTIPLAYER ═══════ */
function generateRoomCode(){
  var chars='ABCDEFGHJKLMNPQRSTUVWXYZ23456789',code='';
  for(var i=0;i<5;i++) code+=chars[Math.floor(Math.random()*chars.length)];
  return code;
}
function createRoom(){
  if(typeof Peer==='undefined'){alert('PeerJS gagal load');return}
  isHost=true;isOnline=true;
  roomCode=generateRoomCode();
  G.state='mpConnecting';
  try{peer=new Peer('holic-spacer-'+roomCode,{debug:0})}
  catch(e){alert('Gagal membuat peer');isOnline=false;G.state='mpMenu';return}
  peer.on('open',function(){G.state='mpHostWait';hostShip=null;guestShip=null});
  peer.on('error',function(err){
    alert('Gagal buat room: '+(err.type||err.message));
    isOnline=false;isHost=false;G.state='mpMenu';
    if(peer){try{peer.destroy()}catch(e){}peer=null}
  });
  peer.on('connection',function(c){conn=c;setupConnection()});
}
function joinRoom(code){
  if(typeof Peer==='undefined'){joinErr.textContent='Tidak tersedia';return}
  isHost=false;isOnline=true;roomCode=code;
  joinErr.textContent='Menghubungkan...';
  try{peer=new Peer({debug:0})}
  catch(e){joinErr.textContent='Gagal init';return}
  peer.on('open',function(){
    conn=peer.connect('holic-spacer-'+roomCode,{reliable:true});
    setupConnection();
  });
  peer.on('error',function(err){
    joinErr.textContent='Gagal: '+(err.type||'tidak terhubung');
    if(err.type==='peer-unavailable') joinErr.textContent='Room tidak ditemukan';
  });
}
function setupConnection(){
  conn.on('open',function(){
    joinOv.style.display='none';
    G.state='select';
    hostShip=null;guestShip=null;
    conn.send({t:'hello',host:isHost,mode:G.gameMode});
    sfx(880,0.15,'sine',0.05);
  });
  conn.on('data',handleData);
  conn.on('close',function(){
    if(isOnline){
      G.state='menu';isOnline=false;R=null;conn=null;
      showMsg('Koneksi terputus',2.5);
    }
  });
}
function handleData(data){
  if(!data||!data.t) return;
  if(data.t==='hello'){
    if(!isHost){G.state='select';if(data.mode) G.gameMode=data.mode}
    return;
  }
  if(data.t==='ships'){
    if(data.p1!==undefined) hostShip=data.p1;
    if(data.p2!==undefined) guestShip=data.p2;
    if(isHost) tryStartOnline();
    return;
  }
  if(data.t==='start'){
    remoteShip=(isHost?data.p2:data.p1);
    if(data.mode) G.gameMode=data.mode;
    if(!isHost){G.selectedShip=data.p2;beginOnlineGame()}
    return;
  }
  if(data.t==='i'&&isHost){
    if(R&&!R.dead){
      R.x=cl(data.x,R.r+6,W-R.r-6);
      R.y=cl(data.y,R.r+50,H-R.r-6);
      if(data.u) activateUlti(R);
      if(data.u2) activateUlti2(R);
      netRemoteAttackHeld=!!data.a;
    }
    return;
  }
  if(data.t==='s'&&!isHost){applySnapshot(data);return}
  if(data.t==='pvpEnd'&&!isHost){
    if(data.draw) G.state='pvpDraw';
    else if(data.hostWon) G.state='pvpLose';
    else G.state='pvpWin';
    return;
  }
  if(data.t==='gameover'&&!isHost){G.state='gameover';return}
  if(data.t==='bye'){
    if(isOnline){
      G.state='menu';isOnline=false;R=null;conn=null;
      showMsg('Host keluar',2.5);
    }
  }
}
function tryStartOnline(){
  if(!isHost) return;
  if(hostShip===null||guestShip===null) return;
  conn.send({t:'start',p1:hostShip,p2:guestShip,mode:G.gameMode});
  remoteShip=guestShip;
  G.selectedShip=hostShip;
  beginOnlineGame();
}
function cancelMultiplayer(){
  if(conn){try{conn.send({t:'bye'});conn.close()}catch(e){}}
  if(peer){try{peer.destroy()}catch(e){}}
  conn=null;peer=null;isOnline=false;isHost=false;R=null;
  G.state='menu';
}
function beginOnlineGame(){R=createRemotePlayer(remoteShip);startGame()}
function createRemotePlayer(shipIdx){
  var ship=SHIPS[shipIdx];
  return{
    x:W/2,y:H-200,r:ship.r,speed:ship.speed,
    hp:ship.hp,maxHp:ship.hp,cd:0,
    fireRate:ship.fireRate,dmg:ship.dmg,streams:ship.streams,
    invuln:2,hitFlash:0,
    ultiCharge:0,ultiRate:ship.ultiRate,ultiPower:ship.ultiPower,ultiActive:0,
    ulti2Charge:0,ulti2Rate:ship.ultiRate,ulti2Power:ship.ultiPower,ulti2Active:0,ulti2Beam:null,
    pierce:0,dead:false,respawnTimer:0,shipIdx:shipIdx,faceDir:-1,firing:0
  };
}
function hostSendSnapshot(){
  if(!isHost||!conn||!conn.open) return;
  var snap={
    t:'s',
    p1:{x:Math.round(P.x),y:Math.round(P.y),hp:Math.round(P.hp),maxHp:P.maxHp,
        dead:P.dead?1:0,invuln:+P.invuln.toFixed(2),shipIdx:G.selectedShip,
        ultiCharge:+P.ultiCharge.toFixed(2),ultiActive:+P.ultiActive.toFixed(2),r:P.r,
        faceDir:P.faceDir,
        ulti2Charge:+P.ulti2Charge.toFixed(2),ulti2Active:+P.ulti2Active.toFixed(2),
        beam:P.ulti2Beam?{x:Math.round(P.ulti2Beam.x),w:Math.round(P.ulti2Beam.w),
          life:+P.ulti2Beam.life.toFixed(2),maxLife:+P.ulti2Beam.maxLife.toFixed(2)}:null},
    p2:{x:Math.round(R.x),y:Math.round(R.y),hp:Math.round(R.hp),maxHp:R.maxHp,
        dead:R.dead?1:0,invuln:+R.invuln.toFixed(2),shipIdx:remoteShip,
        ultiCharge:+R.ultiCharge.toFixed(2),ultiActive:+R.ultiActive.toFixed(2),
