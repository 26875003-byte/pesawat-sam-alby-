  sfx(40,1.0,'sawtooth',0.12);

  for(var i=0;i<60;i++){
    addParticle(target.x,target.y,
      ['#ffd166','#ff9f1c','#ffffff','#f72585'][Math.floor(Math.random()*4)],rnd(1.5,3));
  }
}
function updateUlti2Beam(target,dt){
  if(!target.ulti2Beam) return;
  var b=target.ulti2Beam;
  b.life-=dt;
  var dmgPerSec=(120+G.level*5)*target.ulti2Power;

  if(G.gameMode!=='pvp'){
    for(var i=enemies.length-1;i>=0;i--){
      var e=enemies[i];
      if(Math.abs(e.x-b.x)<b.w*0.55+e.r){
        e.hp-=dmgPerSec*dt;
        e.hitFlash=0.05;
        if(e.hp<=0) killEnemy(i,true);
      }
    }
    if(boss&&!boss.entering&&Math.abs(boss.x-b.x)<b.w*0.55+boss.r){
      boss.hp-=dmgPerSec*dt*1.3;
      boss.hitFlash=0.06;
      if(boss.hp<=0) bossDefeated();
    }
  }else{
    var opp=target===P?R:P;
    if(opp&&!opp.dead&&Math.abs(opp.x-b.x)<b.w*0.55+opp.r){
      opp.hp-=dmgPerSec*dt*0.5;
      if(opp.hp<=0) damagePlayer(opp,999);
    }
  }

  for(var k=0;k<3;k++){
    particles.push({
      x:b.x+rnd(-b.w*0.45,b.w*0.45),y:Math.random()*H,
      vx:rnd(-150,150),vy:rnd(-400,-150),
      life:rnd(0.3,0.7),maxLife:0.7,
      color:['#ffd166','#ff9f1c','#ffffff'][Math.floor(Math.random()*3)],
      size:rnd(1.5,4),drag:0.94
    });
  }

  if(b.life<=0){
    target.ulti2Beam=null;
    G.shake=settings.screenShake?0.8:0;
    G.flash=0.4;
    sfx(180,0.4,'sawtooth',0.08);
  }
}

/* ═══════ HEAL & PICKUPS ═══════ */
function healPlayer(amount,x,y,sourceColor){
  if(P.dead||P.hp>=P.maxHp) return;
  var before=P.hp;
  P.hp=Math.min(P.maxHp,P.hp+amount);
  var actual=Math.round(P.hp-before);
  if(actual<=0) return;
  var hx=(x!==undefined)?x:P.x;
  var hy=(y!==undefined)?y:P.y;
  var col=sourceColor||'#06d6a0';
  floatingTexts.push({x:hx,y:hy,text:'+'+actual+' HP',color:col,life:1.3,maxLife:1.3,vy:-70});
  for(var i=0;i<10;i++){
    var a=Math.random()*TAU;
    var spd=rnd(40,140);
    particles.push({x:hx,y:hy,vx:Math.cos(a)*spd,vy:Math.sin(a)*spd-50,
      life:rnd(0.4,0.9),maxLife:0.9,color:col,size:rnd(2,4.5),drag:0.94});
  }
  G.healFlash=0.45;
  sfx(660,0.08,'sine',0.04);
}
function spawnPickup(x,y,forcedType){
