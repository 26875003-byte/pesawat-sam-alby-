    ctx.fillStyle=cardG;
    roundRect(ctx,r.x,r.y,r.w,r.h,14);ctx.fill();
    ctx.shadowBlur=0;
    ctx.strokeStyle=selected?ship.color:'rgba(123,223,242,0.35)';
    ctx.lineWidth=selected?3:2;
    roundRect(ctx,r.x,r.y,r.w,r.h,14);ctx.stroke();
