    ctx.fillText('SKOR  '+G.score.toLocaleString('id-ID'),pad,pad+22);
  }
  var rank=getRank(G.killsThisRun);
  ctx.fillStyle=rank.color;
  ctx.font='bold 13px Segoe UI, Arial';
  ctx.fillText('★ '+rank.name+' ('+G.killsThisRun+' kills)',pad,pad+42);
  ctx.fillStyle='#06d6a0';ctx.font='bold 11px Segoe UI, Arial';
  ctx.fillText('❤ Heal/kill: 3~8 HP',pad,pad+60);
  if(G.gameMode!=='bossrush'){
    var nextBoss=(BOSS_EVERY-(G.level%BOSS_EVERY))%BOSS_EVERY;
    ctx.fillStyle='#ffd166';ctx.font='12px Segoe UI, Arial';
    ctx.fillText(levelState.isBoss?'BOSS FIGHT!':'Boss dalam '+nextBoss+' level',pad,pad+76);
  }
  ctx.restore();

  /* Top-right */
  ctx.save();
  ctx.textAlign='right';ctx.textBaseline='top';
  ctx.fillStyle='rgba(0,0,0,0.5)';
  roundRect(ctx,W-pad-180,pad-4,180,62,10);ctx.fill();
  ctx.strokeStyle='rgba(123,223,242,0.2)';ctx.lineWidth=1;
  roundRect(ctx,W-pad-180,pad-4,180,62,10);ctx.stroke();
  ctx.font='bold 11px Segoe UI, Arial';
  ctx.fillStyle='#ffd166';
  var bestForMode=G.gameMode==='bossrush'?(saveData.bossRushBest||0):saveData.best;
  ctx.fillText('BEST: '+bestForMode.toLocaleString('id-ID'),W-pad,pad);
  ctx.fillStyle=SHIPS[G.selectedShip].color;
  ctx.font='bold 12px Segoe UI, Arial';
  ctx.fillText('✦ '+SHIPS[G.selectedShip].name,W-pad,pad+18);
  ctx.fillStyle='#ff6b6b';
  ctx.font='bold 14px Segoe UI, Arial';
  ctx.fillText('BOSS: '+G.bossesKilled+' / '+MAX_BOSS,W-pad,pad+36);
  if(settings.showFps){
    ctx.fillStyle='#06d6a0';ctx.font='bold 11px Segoe UI, Arial';
    ctx.fillText('FPS: '+G.fps,W-pad,pad+52);
  }
  ctx.restore();

  /* HP bar */
  var hw=190,hh=18;
  var hx=pad,hy=H-pad-hh;
  ctx.save();
  ctx.fillStyle='rgba(0,0,0,0.6)';
  roundRect(ctx,hx-3,hy-3,hw+6,hh+6,6);ctx.fill();
  ctx.fillStyle='#1a2236';ctx.fillRect(hx,hy,hw,hh);
  var hpRatio=Math.max(0,G.hudHp/100);
  var hpGrad=ctx.createLinearGradient(hx,hy,hx+hw,hy);
  if(hpRatio>0.5){hpGrad.addColorStop(0,'#06d6a0');hpGrad.addColorStop(1,'#4cc9f0')}
  else if(hpRatio>0.25){hpGrad.addColorStop(0,'#ffd166');hpGrad.addColorStop(1,'#ff9f1c')}
  else{hpGrad.addColorStop(0,'#ff4d6d');hpGrad.addColorStop(1,'#c1001f')}
