/* ═══════ LEVELS ═══════ */
function startLevel(n){
  G.level=n;
  var isBoss=(n%BOSS_EVERY===0);
  levelState.isBoss=isBoss;
  levelState.toSpawn=0;
  enemies.length=0;
  if(isBoss){
    var idx=n/BOSS_EVERY;
    boss=createBoss(idx);
    G.bossWarning=2.5;
    showMsg('⚠ BOSS '+idx+' / 100 ⚠',2.0);
    sfx(300,0.3,'sawtooth',0.08);
  }else{
    levelState.toSpawn=Math.min(30,4+Math.floor(n*0.8));
    levelState.spawnInterval=Math.max(0.28,1.0-n*0.02);
    levelState.spawnTimer=0.5;
    showMsg('LEVEL '+n,1.2);
  }
  levelPhase='intro';
  introT=isBoss?1.4:0.7;
}
function nextLevel(){
  if(G.level>=MAX_LEVEL){G.state='win';return}
  startLevel(G.level+1);
}
function updateLevel(dt){
  if(G.gameMode==='pvp'||G.gameMode==='bossrush') return;
  if(levelPhase==='intro'){introT-=dt;if(introT<=0) levelPhase='combat';return}
  if(levelPhase==='clear'){
    clearT-=dt;
    if(clearT<=0){
      if(levelState.isBoss&&G.level<MAX_LEVEL) showUpgrade();
      else nextLevel();
    }
    return;
  }
  if(levelState.isBoss) return;
  if(levelState.toSpawn>0){
    levelState.spawnTimer-=dt;
    while(levelState.spawnTimer<=0&&levelState.toSpawn>0){
      levelState.spawnTimer+=levelState.spawnInterval;
      levelState.toSpawn--;
      spawnEnemy(G.level);
    }
  }else if(enemies.length===0){
    G.score+=30+G.level*10;
    levelPhase='clear';
    clearT=1.1;
    showMsg('LEVEL '+G.level+' SELESAI',1.1);
    sfx(660,0.15,'sine',0.05);
  }
}
function showUpgrade(){
  if(isOnline&&!isHost){G.state='upgradeWait';showMsg('Host memilih upgrade...',60);return}
  G.state='upgrade';G.msgT=0;
  var pool=UPGRADES.filter(function(u){return !u.maxed||!u.maxed()});
  var picks=[],copy=pool.slice();
  for(var i=0;i<3&&copy.length>0;i++) picks.push(copy.splice(Math.floor(Math.random()*copy.length),1)[0]);
  upgradeChoices=picks;
  sfx(520,0.3,'sine',0.06);
}
function selectUpgrade(index){
  if(index<0||index>=upgradeChoices.length) return;
  upgradeChoices[index].apply();
  upgradeChoices=[];
  G.state='playing';
  sfx(880,0.18,'sine',0.06);
  nextLevel();
}

