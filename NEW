    ctx.restore();
    var pulse2=0.5+Math.sin(G.time*3)*0.5;
    ctx.globalAlpha=pulse2;
    ctx.font='bold 18px Segoe UI, Arial';
    ctx.fillStyle='#ffd166';
    ctx.fillText('● Menunggu pemain bergabung...',W/2,cy+40);
    ctx.globalAlpha=1;
    var btn={x:W/2-100,y:H-120,w:200,h:52,label:'BATAL'};
    drawButton(btn,'rgba(239,71,111,0.25)','#ef476f');
    ctx.restore();
    return;
  }else if(G.state==='paused'){
    ctx.font='bold 44px Segoe UI, Arial';
    ctx.fillStyle='#ffd166';
    ctx.fillText('⏸ JEDA',W/2,cy-40);
    var btns3=getPauseButtonRects();
    for(var i=0;i<btns3.length;i++) drawButton(btns3[i],'rgba(155,179,201,0.2)',btns3[i].color);
  }else if(G.state==='upgradeWait'){
    ctx.font='bold 26px Segoe UI, Arial';
    ctx.fillStyle='#ffd166';
    ctx.fillText('⏳ HOST MEMILIH UPGRADE...',W/2,cy);
  }else if(G.state==='bossrushEnd'){
    ctx.font='bold '+Math.min(48,W/11)+'px Segoe UI, Arial';
    ctx.fillStyle='#ff9f1c';
    ctx.shadowBlur=22;ctx.shadowColor='#ff9f1c';
    ctx.fillText('🔥 BOSS RUSH SELESAI',W/2,cy-120);
    ctx.shadowBlur=0;
    ctx.font='bold 24px Segoe UI, Arial';
    ctx.fillStyle='#ffffff';
    ctx.fillText('Kamu kalahkan '+G.bossRushIdx+' boss',W/2,cy-50);
    ctx.fillStyle='#ffd166';
    ctx.fillText('Skor: '+G.score.toLocaleString('id-ID'),W/2,cy-10);
    var mm=String(Math.floor(G.bossRushTime/60)).padStart(2,'0');
    var ss=String(Math.floor(G.bossRushTime%60)).padStart(2,'0');
    ctx.fillStyle='#7bdff2';
    ctx.fillText('⏱ Waktu: '+mm+':'+ss,W/2,cy+26);
    if(G.bossRushIdx>=(saveData.bossRushBest||0)){
      ctx.fillStyle='#06d6a0';
      ctx.font='bold 18px Segoe UI, Arial';
      ctx.fillText('🎉 NEW RECORD!',W/2,cy+62);
    }
    ctx.font='bold 18px Segoe UI, Arial';
    ctx.fillStyle='#06d6a0';
    ctx.fillText('▶ KETUK UNTUK KEMBALI',W/2,cy+110);
  }else if(G.state==='gameover'){
    ctx.font='bold '+Math.min(52,W/12)+'px Segoe UI, Arial';
    ctx.shadowBlur=24;ctx.shadowColor='#ff4d6d';
    ctx.fillStyle='#ff4d6d';
    ctx.fillText('GAME OVER',W/2,cy-100);
    ctx.shadowBlur=0;
    /* Stats grid */
    var stats=[
      {label:'Skor',value:G.score.toLocaleString('id-ID'),color:'#ffd166'},
      {label:'Level',value:G.level,color:'#7bdff2'},
      {label:'Boss',value:G.bossesKilled+' / '+MAX_BOSS,color:'#ff6b6b'}
    ];
    for(var i=0;i<stats.length;i++){
      var st=stats[i];
      var sy=cy-30+i*36;
      ctx.font='bold 14px Segoe UI, Arial';
      ctx.fillStyle='#9bb3c9';
      ctx.textAlign='right';
      ctx.fillText(st.label+':',W/2-10,sy);
      ctx.fillStyle=st.color;
      ctx.textAlign='left';
      ctx.fillText(st.value,W/2+10,sy);
    }
    ctx.textAlign='center';
    ctx.font='bold 18px Segoe UI, Arial';
    ctx.fillStyle='#06d6a0';
    ctx.fillText('▶ KETUK UNTUK KEMBALI',W/2,cy+110);
  }else if(G.state==='win'){
    ctx.font='bold '+Math.min(50,W/11)+'px Segoe UI, Arial';
    ctx.shadowBlur=30;ctx.shadowColor='#ffd166';
    ctx.fillStyle='#ffd166';
    ctx.fillText('🏆 KAMU MENANG! 🏆',W/2,cy-110);
    ctx.shadowBlur=0;
    ctx.font='bold 26px Segoe UI, Arial';
    ctx.fillStyle='#fff';
    ctx.fillText('SEMUA 100 BOSS DIKALAHKAN!',W/2,cy-40);
    ctx.font='bold 20px Segoe UI, Arial';
    ctx.fillStyle='#7bdff2';
    ctx.fillText('Skor Akhir: '+G.score.toLocaleString('id-ID'),W/2,cy+20);
    ctx.font='bold 18px Segoe UI, Arial';
    ctx.fillStyle='#06d6a0';
    ctx.fillText('▶ KETUK UNTUK KEMBALI',W/2,cy+100);
  }else if(G.state==='pvpWin'||G.state==='pvpLose'||G.state==='pvpDraw'){
    var isWin=G.state==='pvpWin',isDraw=G.state==='pvpDraw';
    ctx.font='bold '+Math.min(60,W/10)+'px Segoe UI, Arial';
    ctx.shadowBlur=30;
    ctx.shadowColor=isDraw?'#ffd166':(isWin?'#06d6a0':'#ff0054');
    ctx.fillStyle=isDraw?'#ffd166':(isWin?'#06d6a0':'#ff0054');
    var titleTxt=isDraw?'⚖ DRAW ⚖':(isWin?'🏆 VICTORY! 🏆':'💀 DEFEAT 💀');
    ctx.fillText(titleTxt,W/2,cy-80);
    ctx.shadowBlur=0;
    ctx.font='bold 22px Segoe UI, Arial';
    ctx.fillStyle='#fff';
    var subTxt=isDraw?'KEDUA PEMAIN TUMBANG':(isWin?'KAMU MENANG!':'LAWAN MENANG');
    ctx.fillText(subTxt,W/2,cy-10);
    ctx.font='bold 18px Segoe UI, Arial';
    ctx.fillStyle='#06d6a0';
    ctx.fillText('▶ KETUK UNTUK KEMBALI',W/2,cy+80);
  }
  ctx.restore();
}

/* ═══════ RENDER ═══════ */
function render(){
  ctx.setTransform(DPR,0,0,DPR,0,0);
  var bg=ctx.createLinearGradient(0,0,0,H);
  bg.addColorStop(0,'#05060f');
  bg.addColorStop(0.55,'#0a1024');
  bg.addColorStop(1,G.gameMode==='pvp'?'#1a0a14':(G.gameMode==='bossrush'?'#1a1008':'#120a1e'));
  ctx.fillStyle=bg;
  ctx.fillRect(0,0,W,H);
  drawNebulas();
  drawStars();
  drawBloodDecals();
  drawUlti2Beams();

  ctx.save();
  if(G.shake>0&&settings.screenShake){
    var s=G.shake*11;
    ctx.translate(rnd(-s,s),rnd(-s,s));
  }
  var showWorld=G.state==='playing'||G.state==='paused'||G.state==='upgradeWait'||
    G.state==='pvpWin'||G.state==='pvpLose'||G.state==='pvpDraw'||
    G.state==='gameover'||G.state==='win'||G.state==='bossrushEnd';
  if(showWorld){
    drawParticles();
    drawFloatingTexts();
    drawBullets();
    for(var i=0;i<enemies.length;i++) drawEnemy(enemies[i]);
    drawBoss();
    drawPickups();
    drawPlayerShip(P,G.selectedShip,true);
    if(isOnline&&R) drawPlayerShip(R,remoteShip,false);
  }
  ctx.restore();

  if(G.flash>0){
    ctx.fillStyle='rgba(255,255,255,'+(G.flash*0.35).toFixed(3)+')';
    ctx.fillRect(0,0,W,H);
  }
  if(settings.bloodEffects) drawScreenBlood();
  if(settings.bloodEffects) drawBloodDrips();
  drawHealFlash();
  drawDamageFlash();
  drawLowHpWarning();
  drawVignette();
  drawScanlines();

  if(G.state==='playing'||G.state==='paused'||G.state==='upgradeWait'){
    drawHUD();
    drawKillFeed();
    drawAttackButton();
    drawUltiButton();
    drawUlti2Button();
  }
  drawMessage();
  drawOverlay();
  drawWatermark();
}

/* ═══════ LOOP ═══════ */
var lastT=0;
function loop(t){
  if(!lastT) lastT=t;
  var dt=(t-lastT)/1000;
  lastT=t;
  if(dt>0.05) dt=0.05;
  if(dt<0) dt=0;
  update(dt);
  render();
  requestAnimationFrame(loop);
}

/* ═══════ INIT ═══════ */
resize();
initStars();
initNebulas();
window.addEventListener('resize',function(){initStars();initNebulas();});
P.x=W/2;
P.y=H-120;
requestAnimationFrame(loop);

})();
</script>
</body>
</html>
