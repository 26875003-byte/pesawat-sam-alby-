function drawPlayerShip(pl,shipIdx,isLocal){
  if(pl.dead) return;
  if(pl.invuln>0&&Math.floor(pl.invuln*14)%2===0&&G.state==='playing'&&!isOnline) return;
  var ship=SHIPS[shipIdx];
  ctx.save();
  ctx.translate(pl.x,pl.y);
  if(pl.faceDir>0) ctx.rotate(Math.PI);

  /* Engine glow */
  var engGlow=ctx.createRadialGradient(0,14,0,0,14,20);
  engGlow.addColorStop(0,ship.color+'AA');
  engGlow.addColorStop(1,ship.color+'00');
  ctx.fillStyle=engGlow;
  ctx.beginPath();ctx.arc(0,14,20,0,TAU);ctx.fill();

  /* Ulti rings */
  if(pl.ultiActive>0){
    var t=1-pl.ultiActive/1.6;
    var rr=t*Math.max(W,H)*0.85;
    ctx.save();
    ctx.globalAlpha=(1-t)*0.85;
    ctx.strokeStyle='#f72585';ctx.lineWidth=7;
    ctx.beginPath();ctx.arc(0,0,rr,0,TAU);ctx.stroke();
    ctx.globalAlpha=(1-t)*0.45;
    ctx.strokeStyle='#7bdff2';ctx.lineWidth=3;
    ctx.beginPath();ctx.arc(0,0,rr*0.72,0,TAU);ctx.stroke();
    ctx.restore();
  }
  if(pl.ulti2Active>0){
    var t2=1-pl.ulti2Active/2.0;
    var rr2=t2*Math.max(W,H)*0.6;
    ctx.save();
    ctx.globalAlpha=(1-t2)*0.5;
    ctx.strokeStyle='#ffd166';ctx.lineWidth=5;
    ctx.beginPath();ctx.arc(0,0,rr2,0,TAU);ctx.stroke();
    ctx.restore();
  }

  /* Shield hexagon */
  if(isLocal&&buffs.shield>0){
    var shieldR=pl.r+10;
    var pulse=0.5+Math.sin(G.time*4)*0.5;
    ctx.save();
    ctx.strokeStyle='rgba(76,201,240,'+(0.6+pulse*0.3)+')';
    ctx.lineWidth=2;
    ctx.beginPath();
    for(var h=0;h<6;h++){
      var ha=(h/6)*TAU+G.time;
      var hx=Math.cos(ha)*shieldR;
      var hy=Math.sin(ha)*shieldR;
      if(h===0) ctx.moveTo(hx,hy); else ctx.lineTo(hx,hy);
    }
    ctx.closePath();ctx.stroke();
    ctx.strokeStyle='rgba(150,220,255,'+(0.3+pulse*0.2)+')';
    ctx.lineWidth=1.5;
    ctx.beginPath();ctx.arc(0,0,shieldR+4,0,TAU);ctx.stroke();
    ctx.restore();
  }

  /* Flame with layers */
  var flame=14+Math.sin(G.time*40+(isLocal?0:5))*6;
  var fg=ctx.createLinearGradient(0,10,0,10+flame);
  fg.addColorStop(0,'rgba(255,200,90,0.95)');
  fg.addColorStop(0.5,'rgba(255,100,30,0.7)');
  fg.addColorStop(1,'rgba(255,80,20,0)');
  ctx.fillStyle=fg;
  ctx.beginPath();ctx.moveTo(-7,10);ctx.lineTo(7,10);ctx.lineTo(0,10+flame);ctx.closePath();ctx.fill();
  var fg2=ctx.createLinearGradient(0,10,0,10+flame*0.6);
  fg2.addColorStop(0,'rgba(255,255,200,0.9)');
  fg2.addColorStop(1,'rgba(255,200,100,0)');
  ctx.fillStyle=fg2;
  ctx.beginPath();ctx.moveTo(-3,10);ctx.lineTo(3,10);ctx.lineTo(0,10+flame*0.6);ctx.closePath();ctx.fill();

  /* Weapon glow when firing */
  if(pl.firing>0){
    ctx.shadowBlur=15;
    ctx.shadowColor=ship.color;
  }

  drawShipBody(shipIdx,pl.hitFlash>0,ship.color,ship.color2);
  ctx.shadowBlur=0;

  ctx.restore();

  /* P1/P2 labels */
  if(isOnline&&!isLocal){
    var label=(G.gameMode==='pvp')?(isHost?'P2':'P1'):'P2';
    var labelY=pl.faceDir>0?pl.y+ship.r+12:pl.y-ship.r-10;
    ctx.save();
    ctx.fillStyle='rgba(255,255,255,0.85)';
    ctx.font='bold 11px Segoe UI, Arial';
    ctx.textAlign='center';
    ctx.fillText(label,pl.x,labelY);
    ctx.restore();
  }
  if(isOnline&&isLocal&&G.gameMode==='pvp'){
    var label2=isHost?'P1':'P2';
    var labelY2=pl.faceDir>0?pl.y+ship.r+12:pl.y-ship.r-10;
    ctx.save();
    ctx.fillStyle='rgba(123,223,242,0.9)';
    ctx.font='bold 11px Segoe UI, Arial';
    ctx.textAlign='center';
    ctx.fillText(label2,pl.x,labelY2);
    ctx.restore();
  }
}
function drawEnemy(e){
  ctx.save();
  ctx.translate(e.x,e.y);
  var flash=e.hitFlash>0;
  var col='#ff4d6d',col2='#a4161a';
  if(e.type==='zig'){col='#c77dff';col2='#7b2cbf'}
  if(e.type==='diver'){col='#ffd166';col2='#e07a00'}
  if(e.type==='tank'){col='#ff9f1c';col2='#b45309'}
  if(e.type==='sniper'){col='#06d6a0';col2='#05805f'}

  var r=e.r;
  ctx.shadowBlur=flash?20:8;
  ctx.shadowColor=col;

  if(e.type==='grunt'){
    ctx.fillStyle=flash?'#ffffff':col2;
    ctx.beginPath();
    ctx.moveTo(0,r);ctx.lineTo(r*0.9,-r*0.6);
    ctx.lineTo(0,-r*0.2);ctx.lineTo(-r*0.9,-r*0.6);
    ctx.closePath();ctx.fill();
    ctx.fillStyle=flash?'#ffffff':col;
    ctx.beginPath();
    ctx.moveTo(0,r*0.7);ctx.lineTo(r*0.4,-r*0.35);ctx.lineTo(-r*0.4,-r*0.35);
    ctx.closePath();ctx.fill();
  }else if(e.type==='zig'){
    ctx.fillStyle=flash?'#ffffff':col2;
    ctx.beginPath();
    ctx.moveTo(0,-r);ctx.lineTo(r,0);ctx.lineTo(0,r);ctx.lineTo(-r,0);
    ctx.closePath();ctx.fill();
    ctx.fillStyle=flash?'#ffffff':col;
    ctx.beginPath();
    ctx.moveTo(0,-r*0.5);ctx.lineTo(r*0.5,0);ctx.lineTo(0,r*0.5);ctx.lineTo(-r*0.5,0);
    ctx.closePath();ctx.fill();
  }else if(e.type==='diver'){
    ctx.fillStyle=flash?'#ffffff':col;
    ctx.beginPath();
    ctx.moveTo(0,r);ctx.lineTo(r*0.7,-r*0.4);
    ctx.lineTo(0,-r);ctx.lineTo(-r*0.7,-r*0.4);
    ctx.closePath();ctx.fill();
    ctx.fillStyle=flash?'#fff':col2;
    ctx.beginPath();
    ctx.moveTo(0,r*0.5);ctx.lineTo(r*0.3,-r*0.3);ctx.lineTo(-r*0.3,-r*0.3);
    ctx.closePath();ctx.fill();
  }else if(e.type==='tank'){
    ctx.fillStyle=flash?'#ffffff':col2;
    ctx.beginPath();
    for(var i=0;i<6;i++){
      var a=i/6*TAU-Math.PI/2;
      var x=Math.cos(a)*r,y=Math.sin(a)*r;
      if(i===0) ctx.moveTo(x,y);else ctx.lineTo(x,y);
    }
    ctx.closePath();ctx.fill();
    ctx.strokeStyle=flash?'#ffffff':col;ctx.lineWidth=2;
    ctx.stroke();
    ctx.fillStyle=flash?'#ffffff':col;
    ctx.beginPath();ctx.arc(0,0,r*0.4,0,TAU);ctx.fill();
    ctx.fillStyle=flash?'#fff':col2;
    ctx.beginPath();ctx.arc(0,0,r*0.2,0,TAU);ctx.fill();
  }else{
    ctx.fillStyle=flash?'#ffffff':col2;
    ctx.beginPath();
    ctx.moveTo(0,r);ctx.lineTo(r*0.6,-r*0.2);
    ctx.lineTo(r*0.2,-r*0.9);ctx.lineTo(-r*0.2,-r*0.9);
    ctx.lineTo(-r*0.6,-r*0.2);
    ctx.closePath();ctx.fill();
    ctx.strokeStyle=flash?'#ffffff':col;ctx.lineWidth=2;
    ctx.stroke();
    ctx.fillStyle=flash?'#fff':col;
    ctx.beginPath();ctx.arc(0,r*0.2,r*0.25,0,TAU);ctx.fill();
    ctx.strokeStyle=flash?'#fff':'rgba(255,255,255,0.6)';
    ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(0,r*0.2);ctx.lineTo(Math.cos(e.angle)*r,Math.sin(e.angle)*r);ctx.stroke();
  }
  ctx.shadowBlur=0;
  ctx.restore();

  if(e.hp<e.maxHp){
    var w=e.r*2;
    ctx.fillStyle='rgba(0,0,0,0.6)';
    ctx.fillRect(e.x-w/2,e.y-e.r-14,w,4);
    var ratio=e.hp/e.maxHp;
    var hpGrad=ctx.createLinearGradient(e.x-w/2,0,e.x+w/2,0);
    if(ratio>0.5){hpGrad.addColorStop(0,'#ff9f1c');hpGrad.addColorStop(1,'#ffd166')}
    else if(ratio>0.25){hpGrad.addColorStop(0,'#ff6b6b');hpGrad.addColorStop(1,'#ff9f1c')}
    else{hpGrad.addColorStop(0,'#8b0000');hpGrad.addColorStop(1,'#ff6b6b')}
    ctx.fillStyle=hpGrad;
    ctx.fillRect(e.x-w/2,e.y-e.r-14,w*ratio,4);
  }
}
function drawBoss(){
  if(!boss) return;
  var b=boss;
  ctx.save();
  ctx.translate(b.x,b.y);
  var flash=b.hitFlash>0;
  var hue=(b.idx*37)%360;
  var pulse=1+Math.sin(b.pulse)*0.05;

  /* Outer aura */
  var auraR=b.r*2.2+Math.sin(b.t*3)*8;
  var gg=ctx.createRadialGradient(0,0,b.r*0.5,0,0,auraR);
  gg.addColorStop(0,'hsla('+hue+',90%,60%,0.4)');
  gg.addColorStop(0.6,'hsla('+hue+',90%,50%,0.15)');
  gg.addColorStop(1,'hsla(0,0%,0%,0)');
  ctx.fillStyle=gg;
  ctx.beginPath();ctx.arc(0,0,auraR,0,TAU);ctx.fill();

  /* Rotating armor plates */
  ctx.save();
  ctx.rotate(b.spin);
  var arms=4+(b.idx%5);
  for(var i=0;i<arms;i++){
    ctx.rotate(TAU/arms);
    var pg=ctx.createLinearGradient(0,-b.r*0.55,b.r*1.45,0);
    pg.addColorStop(0,flash?'#ffffff':'hsl('+hue+',80%,55%)');
    pg.addColorStop(1,flash?'#ffffff':'hsl('+hue+',80%,35%)');
    ctx.fillStyle=pg;
    ctx.beginPath();
    ctx.moveTo(0,-b.r*0.55);ctx.lineTo(b.r*1.45,-b.r*0.14);
    ctx.lineTo(b.r*1.45,b.r*0.14);ctx.lineTo(0,b.r*0.55);
    ctx.closePath();ctx.fill();
    ctx.strokeStyle=flash?'#fff':'hsl('+hue+',95%,70%)';
    ctx.lineWidth=1.5;ctx.stroke();
  }
  ctx.restore();

  /* Body */
  var bg=ctx.createRadialGradient(-b.r*0.3,-b.r*0.3,0,0,0,b.r*pulse);
  bg.addColorStop(0,flash?'#ffffff':'hsl('+hue+',70%,45%)');
  bg.addColorStop(0.7,flash?'#ffffff':'hsl('+hue+',70%,25%)');
  bg.addColorStop(1,flash?'#ffffff':'hsl('+hue+',70%,15%)');
  ctx.fillStyle=bg;
  ctx.beginPath();ctx.arc(0,0,b.r*pulse,0,TAU);ctx.fill();
  ctx.strokeStyle=flash?'#ffffff':'hsl('+hue+',95%,65%)';
  ctx.lineWidth=3;ctx.stroke();

  /* Damage cracks */
  if(b.hp<b.maxHp*0.4&&settings.bloodEffects){
    ctx.strokeStyle='rgba(139,0,0,0.85)';
    ctx.lineWidth=2.5;
    for(var k=0;k<5;k++){
      var a=(k/5)*TAU+0.4;
      ctx.beginPath();
      ctx.moveTo(Math.cos(a)*b.r*0.3,Math.sin(a)*b.r*0.3);
      ctx.lineTo(Math.cos(a+0.15)*b.r*0.7,Math.sin(a+0.15)*b.r*0.7);
      ctx.lineTo(Math.cos(a-0.1)*b.r,Math.sin(a-0.1)*b.r);
      ctx.stroke();
    }
  }

  /* Eye */
  var eyeR=b.r*0.42;
  var eg=ctx.createRadialGradient(0,0,0,0,0,eyeR);
  eg.addColorStop(0,'#ffffff');
  eg.addColorStop(0.5,'hsl('+hue+',100%,70%)');
  eg.addColorStop(1,'hsla('+hue+',100%,50%,0)');
  ctx.fillStyle=eg;
  ctx.beginPath();ctx.arc(0,0,eyeR*(1+Math.sin(b.t*6)*0.08),0,TAU);ctx.fill();

  /* Eye pupil tracking */
  var pd=eyeR*0.4;
  var px2=Math.cos(b.eyeAngle)*pd;
  var py2=Math.sin(b.eyeAngle)*pd;
  ctx.fillStyle='#080808';
  ctx.beginPath();ctx.arc(px2,py2,eyeR*0.35,0,TAU);ctx.fill();
  ctx.fillStyle='#ffffff';
  ctx.beginPath();ctx.arc(px2-eyeR*0.1,py2-eyeR*0.1,eyeR*0.08,0,TAU);ctx.fill();

  ctx.restore();
}
function drawBullets(){
  ctx.save();
  for(var i=0;i<pbullets.length;i++){
    var b=pbullets[i];
    ctx.shadowBlur=b.laser?20:12;
    ctx.shadowColor=b.color||'#7bdff2';
    ctx.fillStyle=b.color||'#7bdff2';
    if(b.laser){
      ctx.beginPath();ctx.ellipse(b.x,b.y,b.r*0.9,b.r*4,0,0,TAU);ctx.fill();
      ctx.fillStyle='rgba(255,255,255,0.85)';
      ctx.beginPath();ctx.ellipse(b.x,b.y,b.r*0.4,b.r*3.2,0,0,TAU);ctx.fill();
    }else if(b.homing){
      ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,TAU);ctx.fill();
      ctx.fillStyle='rgba(255,255,255,0.85)';
      ctx.beginPath();ctx.arc(b.x,b.y,b.r*0.5,0,TAU);ctx.fill();
    }else{
      ctx.beginPath();ctx.ellipse(b.x,b.y,b.r*0.75,b.r*2.1,0,0,TAU);ctx.fill();
      ctx.fillStyle='rgba(255,255,255,0.7)';
      ctx.beginPath();ctx.ellipse(b.x,b.y,b.r*0.35,b.r*1.2,0,0,TAU);ctx.fill();
    }
  }
  ctx.restore();
  ctx.save();
  for(var i2=0;i2<ebullets.length;i2++){
    var b2=ebullets[i2];
    ctx.shadowBlur=b2.big?20:10;
    ctx.shadowColor=b2.color;
    ctx.fillStyle=b2.color;
    ctx.beginPath();ctx.arc(b2.x,b2.y,b2.r,0,TAU);ctx.fill();
    ctx.fillStyle='rgba(255,255,255,0.85)';
    ctx.beginPath();ctx.arc(b2.x,b2.y,b2.r*0.42,0,TAU);ctx.fill();
  }
  ctx.restore();
}
function drawParticles(){
  ctx.save();
  for(var i=0;i<particles.length;i++){
    var p=particles[i];
    var a=Math.max(0,p.life/p.maxLife);
    ctx.globalAlpha=a;
    if(p.mist){
      var g=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.size);
      g.addColorStop(0,'rgba(139,0,0,0.6)');
      g.addColorStop(1,'rgba(80,0,0,0)');
      ctx.fillStyle=g;
      ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,TAU);ctx.fill();
    }else if(p.blood){
      var spd=Math.hypot(p.vx,p.vy);
      var ang=Math.atan2(p.vy,p.vx);
      ctx.save();
      ctx.translate(p.x,p.y);ctx.rotate(ang);
      ctx.fillStyle=p.color;
      ctx.beginPath();
      ctx.ellipse(0,0,p.size*a*(1+Math.min(2,spd/300)),p.size*a,0,0,TAU);
      ctx.fill();
      ctx.restore();
    }else{
      ctx.fillStyle=p.color;
      ctx.beginPath();ctx.arc(p.x,p.y,p.size*a,0,TAU);ctx.fill();
    }
  }
  ctx.restore();
  ctx.globalAlpha=1;
}
function drawUlti2Beams(){
  var drawBeam=function(beam){
    if(!beam) return;
    var b=beam;
    var a=Math.min(1,b.life/0.4)*(0.7+Math.random()*0.3);
    ctx.save();
    var g=ctx.createLinearGradient(b.x-b.w,0,b.x+b.w,0);
    g.addColorStop(0,'rgba(255,209,102,0)');
    g.addColorStop(0.25,'rgba(255,159,28,'+(a*0.5)+')');
    g.addColorStop(0.5,'rgba(255,255,255,'+(a*0.9)+')');
    g.addColorStop(0.75,'rgba(255,159,28,'+(a*0.5)+')');
    g.addColorStop(1,'rgba(255,209,102,0)');
    ctx.fillStyle=g;
    ctx.fillRect(b.x-b.w,0,b.w*2,H);
    ctx.fillStyle='rgba(255,255,255,'+a+')';
    ctx.fillRect(b.x-b.w*0.12,0,b.w*0.24,H);
    var pulse=0.7+Math.random()*0.3;
    var cg=ctx.createRadialGradient(b.x,0,0,b.x,0,b.w*2.5*pulse);
    cg.addColorStop(0,'rgba(255,255,255,'+a+')');
    cg.addColorStop(0.4,'rgba(255,209,102,'+(a*0.7)+')');
    cg.addColorStop(1,'rgba(255,209,102,0)');
    ctx.fillStyle=cg;
    ctx.beginPath();ctx.arc(b.x,0,b.w*2.5*pulse,0,TAU);ctx.fill();
    var bg2=ctx.createRadialGradient(b.x,H,0,b.x,H,b.w*1.8);
    bg2.addColorStop(0,'rgba(255,255,255,'+(a*0.8)+')');
    bg2.addColorStop(1,'rgba(255,209,102,0)');
    ctx.fillStyle=bg2;
    ctx.beginPath();ctx.arc(b.x,H,b.w*1.8,0,TAU);ctx.fill();
    ctx.strokeStyle='rgba(255,255,255,'+(a*0.5)+')';
    ctx.lineWidth=2;
    for(var i=0;i<6;i++){
      var yy=(G.time*800+i*(H/6))%H;
      var wob=Math.sin(G.time*10+i)*8;
      ctx.beginPath();
      ctx.moveTo(b.x-b.w*0.6+wob,yy);
      ctx.lineTo(b.x+b.w*0.6+wob,yy);
      ctx.stroke();
    }
    ctx.restore();
  };
  if(P.ulti2Beam) drawBeam(P.ulti2Beam);
  if(R&&R.ulti2Beam) drawBeam(R.ulti2Beam);
}
