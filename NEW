  }
  ctx.beginPath();ctx.arc(x,y,r,0,TAU);
  var fillG=ctx.createRadialGradient(x-r*0.3,y-r*0.3,0,x,y,r);
  if(ready){fillG.addColorStop(0,'rgba(255,159,28,0.5)');fillG.addColorStop(1,'rgba(255,159,28,0.2)')}
  else{fillG.addColorStop(0,'rgba(10,16,36,0.95)');fillG.addColorStop(1,'rgba(10,16,36,0.85)')}
  ctx.fillStyle=fillG;ctx.fill();
  ctx.beginPath();ctx.arc(x,y,r,0,TAU);
  ctx.strokeStyle=ready?'#ffd166':'rgba(255,159,28,0.45)';
  ctx.lineWidth=3;ctx.stroke();
  if(!ready){
    ctx.beginPath();
    ctx.arc(x,y,r-4,-Math.PI/2,-Math.PI/2+TAU*P.ulti2Charge);
    ctx.strokeStyle='#ff9f1c';ctx.lineWidth=5;
    ctx.lineCap='round';ctx.stroke();
    ctx.lineCap='butt';
  }
  ctx.textAlign='center';ctx.textBaseline='middle';
  if(ready){
    ctx.fillStyle='#fff';
    ctx.font='bold '+Math.floor(r*0.34)+'px Segoe UI, Arial';
    ctx.fillText('BEAM',x,y+1);
    ctx.font='bold 10px Segoe UI, Arial';
    ctx.fillStyle='rgba(255,255,255,0.85)';
    ctx.fillText('E',x,y+r*0.62);
  }else{
    ctx.fillStyle='#ffb84d';
    ctx.font='bold '+Math.floor(r*0.28)+'px Segoe UI, Arial';
    ctx.fillText(Math.floor(P.ulti2Charge*100)+'%',x,y+1);
  }
  ctx.restore();
}
function drawMessage(){
  if(G.msgT<=0) return;
  var t=G.msgT/G.msgMax;
  var alpha=t>0.75?(1-t)/0.25:Math.min(1,t/0.3);
  ctx.save();
  ctx.globalAlpha=cl(alpha,0,1);
  ctx.textAlign='center';ctx.textBaseline='middle';
  var size=Math.min(46,W/14);
  ctx.font='bold '+size+'px Segoe UI, Arial';
  ctx.shadowBlur=22;ctx.shadowColor='#7bdff2';
