    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText((R?Math.ceil(R.hp):0)+' / '+(R?R.maxHp:0),rightX+barW/2,barY+barH/2+1);
    ctx.restore();
    ctx.save();
    var vsY=barY+barH/2;
    var pulse=0.7+Math.sin(G.time*4)*0.3;
    ctx.font='bold 26px Segoe UI, Arial';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.shadowBlur=14;ctx.shadowColor='#f72585';
    ctx.fillStyle='rgba(247,37,133,'+pulse+')';
    ctx.fillText('VS',W/2,vsY);
