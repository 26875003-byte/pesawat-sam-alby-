    case 'shield':buffs.shield+=30;showMsg('🛡 SHIELD +30',1.2);break;
    case 'rapid':buffs.rapidFire=Math.max(buffs.rapidFire,8);showMsg('⚡ RAPID FIRE',1.2);break;
    case 'laser':buffs.weapon='LASER';buffs.weaponTimer=15;showMsg('🔴 LASER',1.5);break;
    case 'spread':buffs.weapon='SPREAD';buffs.weaponTimer=15;showMsg('🟡 SPREAD',1.5);break;
