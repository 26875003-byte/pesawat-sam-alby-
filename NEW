  if(target.ultiCharge<1||target.dead) return;
  target.ultiCharge=0;
  target.ultiActive=1.6;
  target.invuln=Math.max(target.invuln,1.6);
  if(target===P) G.runUltisUsed++;
  if(isOnline&&!isHost) return;

  G.flash=0.65;G.shake=settings.screenShake?1.1:0;
  if(settings.slowMotion) G.slowMo=Math.max(G.slowMo,0.7);
  sfx(60,0.55,'sawtooth',0.09);

  for(var i=0;i<ebullets.length;i++) addParticle(ebullets[i].x,ebullets[i].y,ebullets[i].color,0.8);
  ebullets.length=0;

  if(G.gameMode==='pvp'){
    var dmg=(60+G.level*2)*target.ultiPower;
    if(target===P&&R&&!R.dead) damagePlayer(R,dmg*1.5);
    else if(target===R&&!P.dead) damagePlayer(P,dmg*1.5);
    for(var i=pbullets.length-1;i>=0;i--){
      if(pbullets[i].owner!==(target===P?'P':'R')) pbullets.splice(i,1);
    }
  }else{
    var dmg2=(80+G.level*4)*target.ultiPower;
    for(var i=enemies.length-1;i>=0;i--){
      enemies[i].hp-=dmg2;enemies[i].hitFlash=0.15;
      if(enemies[i].hp<=0) killEnemy(i,true);
    }
    if(boss&&!boss.entering){
      boss.hp-=dmg2*2.6;boss.hitFlash=0.22;
      if(boss.hp<=0) bossDefeated();
    }
  }
  for(var k=0;k<70;k++){
    addParticle(target.x,target.y,
      ['#f72585','#7bdff2','#ffd166','#ffffff'][Math.floor(Math.random()*4)],rnd(1.2,2.2));
  }
}
function activateUlti2(target){
  if(G.state!=='playing') return;
  if(target.ulti2Charge<1||target.dead) return;
  target.ulti2Charge=0;
  target.ulti2Active=2.0;
  target.invuln=Math.max(target.invuln,2.0);
  if(target===P) G.runBeamsUsed++;
  if(isOnline&&!isHost) return;

