      ctx.shadowBlur=16+pulse*14;ctx.shadowColor=ship.color;
    }
    var cardG=ctx.createLinearGradient(r.x,r.y,r.x,r.y+r.h);
    cardG.addColorStop(0,selected?'rgba(40,55,90,0.98)':'rgba(20,28,48,0.94)');
