var keys={};
var dragging=false,dragOffX=0,dragOffY=0,targetX=0,targetY=0;

window.addEventListener('keydown',function(e){
  var k=e.key.toLowerCase();
  keys[k]=true;
  if(['arrowup','arrowdown','arrowleft','arrowright',' '].indexOf(k)!==-1) e.preventDefault();

  if(G.state==='playing'&&(k==='f'||k==='j')) attackHeld=true;

  if(G.state==='upgrade'){
    if(k==='1') selectUpgrade(0);
    else if(k==='2') selectUpgrade(1);
    else if(k==='3') selectUpgrade(2);
    return;
  }
  if(G.state==='select'){
    if(k==='arrowleft'||k==='a'){G.selectedShip=(G.selectedShip+SHIPS.length-1)%SHIPS.length;sfx(560,0.05,'sine',0.03)}
    else if(k==='arrowright'||k==='d'){G.selectedShip=(G.selectedShip+1)%SHIPS.length;sfx(560,0.05,'sine',0.03)}
    else if(k>='1'&&k<='9'&&parseInt(k)<=SHIPS.length){G.selectedShip=parseInt(k)-1}
    else if(k===' '||k==='enter'){confirmShip()}
    return;
  }
  if(G.state==='achievements'&&k==='escape'){G.state='menu';return}
  if(G.state==='leaderboard'&&k==='escape'){G.state='menu';return}
  if(G.state==='settings'&&k==='escape'){persistSettings();G.state='menu';return}

  if(G.state==='menu'&&(k===' '||k==='enter')) G.state='select';
  else if((G.state==='gameover'||G.state==='win'||G.state==='pvpWin'||G.state==='pvpLose'||G.state==='pvpDraw'||G.state==='bossrushEnd')&&(k===' '||k==='enter')) backToMenu();
  else if(G.state==='playing'&&(k==='p'||k==='escape')) G.state='paused';
  else if(G.state==='paused'&&(k==='p'||k==='escape')) G.state='playing';
  else if(G.state==='playing'&&k==='q'){if(isOnline&&!isHost) net.pendingUlti=true;else activateUlti(P)}
  else if(G.state==='playing'&&k==='e'){if(isOnline&&!isHost) net.pendingUlti2=true;else activateUlti2(P)}
  else if(G.state==='playing'&&k===' '){
    if(P.ulti2Charge>=1){if(isOnline&&!isHost) net.pendingUlti2=true;else activateUlti2(P)}
    else if(P.ultiCharge>=1){if(isOnline&&!isHost) net.pendingUlti=true;else activateUlti(P)}
  }
  else if(G.state==='mpHostWait'&&k==='escape'){cancelMultiplayer()}
});
window.addEventListener('keyup',function(e){
  var k=e.key.toLowerCase();
  keys[k]=false;
  if(k==='f'||k==='j') attackHeld=false;
});

function pointerPos(e){
  var r=cv.getBoundingClientRect();
  return{x:e.clientX-r.left,y:e.clientY-r.top};
}

cv.addEventListener('pointerdown',function(e){
  cv.setPointerCapture(e.pointerId);
  var p=pointerPos(e);

  if(G.state==='upgrade'){
    var rects=getUpgradeCardRects();
    for(var i=0;i<rects.length;i++){
      var r=rects[i];
      if(p.x>=r.x&&p.x<=r.x+r.w&&p.y>=r.y&&p.y<=r.y+r.h){selectUpgrade(i);return}
    }
    return;
  }
  if(G.state==='menu'){
    var btns=getMenuButtonRects();
    for(var i=0;i<btns.length;i++){
      var b=btns[i];
      if(p.x>=b.x&&p.x<=b.x+b.w&&p.y>=b.y&&p.y<=b.y+b.h){
        sfx(620,0.08,'sine',0.04);
        if(i===0){isOnline=false;G.gameMode='coop';G.state='select'}
        else if(i===1) G.state='mpMenu';
        else if(i===2) startBossRush();
        else if(i===3) G.state='achievements';
        else if(i===4) G.state='leaderboard';
        else if(i===5) G.state='settings';
        else if(i===6) openRedeemInput();
        return;
      }
    }
    return;
  }
  if(G.state==='achievements'||G.state==='leaderboard'||G.state==='settings'){
    var back=getBackButtonRect();
    if(p.x>=back.x&&p.x<=back.x+back.w&&p.y>=back.y&&p.y<=back.y+back.h){
      if(G.state==='settings') persistSettings();
      G.state='menu'; sfx(620,0.08,'sine',0.04); return;
    }
    if(G.state==='settings'){
      var toggles=getSettingsToggleRects();
      for(var i=0;i<toggles.length;i++){
        var t=toggles[i];
        if(p.x>=t.x&&p.x<=t.x+t.w&&p.y>=t.y&&p.y<=t.y+t.h){
          if(t.id==='reset'){
            if(confirm('Reset semua progress?')){
              Object.keys(saveData).forEach(function(k){delete saveData[k]});
              saveData.best=0; saveData.bestLevel=1; saveData.totalKills=0;
              saveData.pvpWins=0; saveData.achievements={}; saveData.leaderboard=[];
              saveData.bossRushBest=0; saveData.bossRushTimeBest=0;
              saveData.playerName='PLAYER'; saveData.totalDeaths=0;
              saveData.totalRuns=0; saveData.totalPlayTime=0;
              saveData.usedCodes={};
              persistSave();
              showMsg('Progress di-reset',2);
            }
          }else if(t.id==='sfxVolume'){
            settings.sfxVolume=(settings.sfxVolume+0.25)%1.25;
            if(settings.sfxVolume>1) settings.sfxVolume=0;
            persistSettings(); sfx(880,0.1,'sine',0.06);
          }else if(t.id==='name'){openNameInput()}
          else{settings[t.id]=!settings[t.id];persistSettings();sfx(660,0.08,'sine',0.04)}
          return;
        }
      }
    }
    return;
  }
  if(G.state==='mpMenu'){
    var modes=getModeButtonRects();
    for(var i=0;i<modes.length;i++){
      var b=modes[i];
      if(p.x>=b.x&&p.x<=b.x+b.w&&p.y>=b.y&&p.y<=b.y+b.h){
        G.gameMode=b.mode; sfx(720,0.08,'sine',0.04); return;
      }
    }
    var btns2=getMPButtonRects();
    for(var i=0;i<btns2.length;i++){
      var b2=btns2[i];
      if(p.x>=b2.x&&p.x<=b2.x+b2.w&&p.y>=b2.y&&p.y<=b2.y+b2.h){
        if(i===0) createRoom();
        else if(i===1) openJoinInput();
        else G.state='menu';
        sfx(620,0.08,'sine',0.04);
        return;
      }
    }
    return;
  }
  if(G.state==='mpHostWait'){
    var btn={x:W/2-100,y:H-120,w:200,h:52};
    if(p.x>=btn.x&&p.x<=btn.x+btn.w&&p.y>=btn.y&&p.y<=btn.y+btn.h) cancelMultiplayer();
    return;
  }
  if(G.state==='select'){
    var rects2=getShipCardRects();
    for(var i=0;i<rects2.length;i++){
      var r2=rects2[i];
      if(p.x>=r2.x&&p.x<=r2.x+r2.w&&p.y>=r2.y&&p.y<=r2.y+r2.h){
        if(G.selectedShip===i) confirmShip();
        else{G.selectedShip=i;sfx(620,0.08,'sine',0.04)}
        return;
      }
    }
    return;
  }
  if(G.state==='paused'){
    var btns3=getPauseButtonRects();
    for(var i=0;i<btns3.length;i++){
      var b3=btns3[i];
      if(p.x>=b3.x&&p.x<=b3.x+b3.w&&p.y>=b3.y&&p.y<=b3.y+b3.h){
        if(i===0) G.state='playing';
        else if(i===1){backToMenu();G.state='select'}
        else backToMenu();
        sfx(620,0.08,'sine',0.04);
        return;
      }
    }
    return;
  }
  if(G.state==='gameover'||G.state==='win'||G.state==='pvpWin'||G.state==='pvpLose'||G.state==='pvpDraw'||G.state==='bossrushEnd'){backToMenu();return}

  if(G.state==='playing'){
    var ab=getAttackButtonPos();
    if(d2(p.x,p.y,ab.x,ab.y)<(ab.r*1.12)*(ab.r*1.12)){attackHeld=true;return}
    var ub2=getUlti2ButtonPos();
    if(d2(p.x,p.y,ub2.x,ub2.y)<(ub2.r*1.18)*(ub2.r*1.18)){
      if(isOnline&&!isHost) net.pendingUlti2=true;else activateUlti2(P);
      return;
    }
    var ub=getUltiButtonPos();
    if(d2(p.x,p.y,ub.x,ub.y)<(ub.r*1.18)*(ub.r*1.18)){
      if(isOnline&&!isHost) net.pendingUlti=true;else activateUlti(P);
      return;
    }
  }

  dragging=true;
  dragOffX=P.x-p.x;
  dragOffY=P.y-p.y;
  targetX=P.x; targetY=P.y;
});
